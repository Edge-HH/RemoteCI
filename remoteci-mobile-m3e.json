    ] },
    { "id": "control-heading-group", "x": 508, "y": 282, "axis": "x", "items": [
      { "id": "control-heading", "kind": "text", "label": "远程控制", "icon": null, "variant": "filled", "size": 20, "bold": true }
    ] },
    { "id": "control-actions-group", "x": 508, "y": 322, "axis": "x", "items": [
      { "id": "control-view", "kind": "button", "label": "查看画面", "icon": "visibility", "variant": "filled", "size": 182, "action": { "to": "live-view", "transition": "expand" } },
