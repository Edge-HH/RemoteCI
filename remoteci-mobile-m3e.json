{
  "title": "RemoteCI Mobile",
  "brief": "将 RemoteCI 的设备控制、实时查看、任务协作和人员管理浓缩到手机端。面向值班管理员：先看到风险，再用一次明确操作完成处置。",
  "frame": "phone",
  "platform": "android",
  "paletteKey": "teal",
  "theme": { "dark": true, "bothModes": true, "contrast": "standard", "shape": "rounded", "font": "robotoFlex", "emphasized": true, "motion": "expressive" },
  "frames": [
    { "id": "devices", "name": "设备总览", "x": 0, "y": 0, "note": "按状态展示已配对设备；管理员可快速进入单台设备的控制面板。", "bg": "surface" },
    { "id": "device-control", "name": "设备控制", "x": 492, "y": 0, "note": "单台设备的实时状态、远程操作与维护入口；高风险操作需要二次确认。", "bg": "surface" },
    { "id": "live-view", "name": "实时监看", "x": 984, "y": 0, "note": "查看设备的实时画面和近期日志；远程输入始终显示连接状态。", "bg": "surface" },
    { "id": "jobs", "name": "任务与告警", "x": 0, "y": 972, "note": "集中查看构建任务、部署进度和需要值班员处理的告警。", "bg": "surface" },
    { "id": "team", "name": "团队与权限", "x": 492, "y": 972, "note": "管理成员、角色和设备访问范围；邀请与权限变更可追溯。", "bg": "surface" }
  ],
  "groups": [
    { "id": "devices-bar-group", "x": 0, "y": 0, "axis": "x", "items": [
      { "id": "devices-bar", "kind": "topAppBar", "label": "设备", "icon": "menu", "icon2": "notifications", "variant": "filled", "actions": { "icon": { "to": "team", "transition": "slide" } } }
    ] },
    { "id": "devices-search-group", "x": 16, "y": 104, "axis": "x", "items": [
      { "id": "devices-search", "kind": "searchBar", "label": "搜索设备、标签或负责人", "icon": "search", "icon2": "tune", "variant": "filled" }
    ] },
    { "id": "devices-filter-group", "x": 16, "y": 176, "axis": "x", "items": [
      { "id": "filter-all", "kind": "chip", "label": "全部 24", "icon": null, "variant": "filled", "checked": true },
      { "id": "filter-online", "kind": "chip", "label": "在线 18", "icon": "wifi", "variant": "filled" },
      { "id": "filter-alert", "kind": "chip", "label": "需处理 3", "icon": "warning", "variant": "filled" }
    ] },
    { "id": "devices-list-group", "x": 16, "y": 232, "axis": "y", "items": [
      { "id": "device-build-01", "kind": "listItem", "label": "build-agent-01", "supporting": "在线 · Windows · 构建中 72%", "icon": "computer", "icon2": "chevron_right", "variant": "filled", "action": { "to": "device-control", "transition": "slide" } },
      { "id": "device-deploy-03", "kind": "listItem", "label": "deploy-node-03", "supporting": "在线 · Linux · 正在部署", "icon": "dns", "icon2": "chevron_right", "variant": "filled", "action": { "to": "device-control", "transition": "slide" } },
      { "id": "device-lab-07", "kind": "listItem", "label": "lab-phone-07", "supporting": "告警 · Android · 9 分钟未响应", "icon": "smartphone", "icon2": "warning", "variant": "filled", "action": { "to": "device-control", "transition": "slide" } },
      { "id": "device-mac-02", "kind": "listItem", "label": "mac-runner-02", "supporting": "离线 · 上次在线 26 分钟前", "icon": "laptop_mac", "icon2": "chevron_right", "variant": "filled", "action": { "to": "device-control", "transition": "slide" } }
