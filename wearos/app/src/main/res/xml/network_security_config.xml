<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        替代全局 usesCleartextTraffic：显式声明信任锚并允许兼容既有部署的明文连接。
        手表界面会对 HTTP 地址持续提示风险，生产环境仍应优先使用 HTTPS/WSS。
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
