<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 监听默认网络切换（Wi-Fi ↔ 蜂窝）后立即重连；只有蜂窝网络时跳过局域网直连。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17 / targetSdk 37：TCP 局域网直连和 UDP 发现均需要运行时授权。 -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16+：允许系统将符合条件的持续通知提升到 Live Update surfaces。 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".RemoteCiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_foreground"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.RemoteCI">

        <!-- 小米折叠/背屏切换时允许系统按新窗口尺寸重建并恢复 Compose 状态。 -->
        <meta-data
            android:name="android.supports_size_changes"
            android:value="true" />
        <meta-data
            android:name="miui.supportAppContinuity"
            android:value="true" />
        <!-- 小米小部件版本号：任一小部件功能变动或新增时必须递增，否则应用的小部件可能被下线。键名由 remoteci.miuiWidget 开关决定。 -->
        <meta-data
            android:name="${miuiWidgetVersionKey}"
            android:value="1" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.RemoteCI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notif.UpdateReceiver"
            android:exported="false" />
        <!--
            小米 HyperOS 小部件：miuiWidget 标识的键名由构建开关 remoteci.miuiWidget 决定（见 app/build.gradle.kts），
            审核通过前保持关闭，组件以安卓原生小部件出现在“安卓小部件”中。receiver 运行在独立的 :widgetProvider 进程，只读取缓存并渲染，
            不拉起主进程；曝光刷新代替系统定时刷新（最短间隔 30 秒）。同功能不同尺寸使用相同 label，
            小部件中心会聚合展示。receiver 类名与 miuiWidget 标识在通过小米审核后不得修改或移除。
        -->
        <receiver
            android:name=".widget.CurrentStatusWidgetProvider"
            android:exported="true"
            android:label="@string/widget_current_status_name"
            android:process=":widgetProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_current_status_info" />
            <meta-data
                android:name="${miuiWidgetKey}"
                android:value="true" />
            <meta-data
                android:name="miuiWidgetRefresh"
                android:value="exposure" />
            <meta-data
                android:name="miuiWidgetRefreshMinInterval"
                android:value="30000" />
        </receiver>

        <receiver
            android:name=".widget.CurrentStatusWideWidgetProvider"
            android:exported="true"
            android:label="@string/widget_current_status_name"
            android:process=":widgetProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_current_status_wide_info" />
            <meta-data
                android:name="${miuiWidgetKey}"
                android:value="true" />
            <meta-data
                android:name="miuiWidgetRefresh"
                android:value="exposure" />
            <meta-data
                android:name="miuiWidgetRefreshMinInterval"
                android:value="30000" />
        </receiver>

        <receiver
            android:name=".widget.ScheduleWidgetProvider"
            android:exported="true"
            android:label="@string/widget_schedule_name"
            android:process=":widgetProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_schedule_info" />
            <meta-data
                android:name="${miuiWidgetKey}"
                android:value="true" />
            <meta-data
                android:name="miuiWidgetRefresh"
                android:value="exposure" />
            <meta-data
                android:name="miuiWidgetRefreshMinInterval"
                android:value="30000" />
        </receiver>

        <receiver
            android:name=".widget.ScheduleLargeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_schedule_name"
            android:process=":widgetProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_schedule_large_info" />
            <meta-data
                android:name="${miuiWidgetKey}"
                android:value="true" />
            <meta-data
                android:name="miuiWidgetRefresh"
                android:value="exposure" />
            <meta-data
                android:name="miuiWidgetRefreshMinInterval"
                android:value="30000" />
        </receiver>

        <receiver
            android:name=".widget.SwapWidgetProvider"
            android:exported="true"
            android:label="@string/widget_swap_name"
            android:process=":widgetProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_swap_info" />
            <meta-data
                android:name="${miuiWidgetKey}"
                android:value="true" />
        </receiver>

        <receiver
            android:name=".widget.WidgetUpdateReceiver"
            android:exported="false"
            android:process=":widgetProvider">
            <intent-filter>
                <action android:name="com.remoteci.mobile.widget.UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
