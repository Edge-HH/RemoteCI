      { "id": "change-target", "kind": "listItem", "label": "目标课程 · 第三节 体育", "supporting": "10:05–10:50 · 操场", "icon": "drag_indicator", "icon2": "edit", "variant": "filled" }
    ] },
    { "id": "change-submit-group", "x": 1000, "y": 440, "axis": "x", "items": [
      { "id": "change-submit", "kind": "button", "label": "提交修改", "icon": "check", "variant": "filled", "size": 380, "note": "提交前校验当前课表修订号；成功后刷新课表并同步在线手表。" }
