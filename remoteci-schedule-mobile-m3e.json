{
  "title": "RemoteCI 课表",
  "brief": "把 RemoteCI WebUI 和手表端的课表、课堂状态、换课、提醒与快捷控制整合到手机。",
  "frame": "phone",
  "platform": "android",
  "paletteKey": "blue",
  "theme": { "dark": false, "bothModes": true, "contrast": "standard", "shape": "rounded", "font": "roboto", "emphasized": true, "motion": "expressive" },
  "frames": [
    { "id": "today", "name": "今日课堂", "x": 0, "y": 0, "note": "首页优先显示当前课程、下节课程和课堂倒计时；这是手表端首页信息的手机化版本。" },
    { "id": "week", "name": "七日课表", "x": 492, "y": 0, "note": "查看从今天开始的七日课表，并可立即向 ClassIsland 拉取最新课表。" },
    { "id": "change", "name": "调课", "x": 984, "y": 0, "note": "有换课权限时，可交换两节课或用指定课程替换目标节次。" },
    { "id": "control", "name": "课堂控制", "x": 0, "y": 972, "note": "发送自定义提醒、老师来了、主界面显示和音量控制等 WebUI 与手表共有操作。" },
    { "id": "watch", "name": "手表与提醒", "x": 492, "y": 972, "note": "管理已登录手表、查看连接状态，并设置需要同步到手表的提醒与扩展入口。" }
  ],
  "groups": [
    { "id": "today-bar-group", "x": 0, "y": 0, "axis": "x", "items": [
      { "id": "today-bar", "kind": "topAppBar", "label": "今日课堂", "icon": "menu", "icon2": "notifications", "variant": "filled" }
    ] },
    { "id": "today-current-group", "x": 16, "y": 104, "axis": "x", "items": [
      { "id": "today-current", "kind": "card", "label": "正在上课 · 信息技术", "supporting": "第二节 09:00–09:45\n距离下课还有 18 分钟", "icon": "schedule", "variant": "filled", "fill": "primaryContainer", "size": 380, "size2": 168, "noImage": true, "action": { "to": "change", "transition": "expand" } }
    ] },
    { "id": "today-next-group", "x": 16, "y": 296, "axis": "y", "items": [
      { "id": "today-next", "kind": "listItem", "label": "下一节 · 体育", "supporting": "第三节 10:05–10:50 · 操场", "icon": "directions_run", "icon2": "chevron_right", "variant": "filled", "action": { "to": "change", "transition": "slide" } },
      { "id": "today-status", "kind": "listItem", "label": "ClassIsland 已连接", "supporting": "课表已于 08:02 同步", "icon": "cloud_done", "icon2": "check_circle", "variant": "filled" }
    ] },
    { "id": "today-actions-group", "x": 16, "y": 456, "axis": "x", "items": [
      { "id": "today-schedule", "kind": "button", "label": "查看七日课表", "icon": "calendar_month", "variant": "filled", "size": 182, "action": { "to": "week", "transition": "slide" } },
      { "id": "today-control", "kind": "button", "label": "课堂控制", "icon": "tune", "variant": "tonal", "size": 182, "action": { "to": "control", "transition": "slide" } }
    ] },
    { "id": "today-nav-group", "x": 0, "y": 788, "axis": "x", "items": [
      { "id": "today-nav", "kind": "bottomNav", "label": "", "icon": null, "variant": "filled", "tabs": [{ "icon": "today", "label": "今天" }, { "icon": "calendar_month", "label": "课表" }, { "icon": "tune", "label": "控制" }, { "icon": "watch", "label": "手表" }], "selected": 0, "actions": { "tab:1": { "to": "week", "transition": "fade" }, "tab:2": { "to": "control", "transition": "fade" }, "tab:3": { "to": "watch", "transition": "fade" } } }
    ] },
    { "id": "week-bar-group", "x": 492, "y": 0, "axis": "x", "items": [
      { "id": "week-bar", "kind": "topAppBar", "label": "七日课表", "icon": "arrow_back", "icon2": "refresh", "variant": "filled", "actions": { "icon": { "to": "back", "transition": "slide" } }, "note": "刷新会向在线 ClassIsland 插件请求最新课表；任务执行中时显示来源并禁止重复请求。" }
    ] },
    { "id": "week-tabs-group", "x": 492, "y": 88, "axis": "x", "items": [
