    { "id": "control-bar-group", "x": 0, "y": 972, "axis": "x", "items": [
      { "id": "control-bar", "kind": "topAppBar", "label": "课堂控制", "icon": "menu", "icon2": "more_vert", "variant": "filled" }
    ] },
