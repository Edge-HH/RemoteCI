<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 同时供 .NET 8 的 ClassIsland 插件和较新运行时的服务端引用。 -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RemoteCI.Shared</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- obj-check 是本地构建检查生成目录，不应被 SDK 的默认 glob 当成源码。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj-check/**</DefaultItemExcludes>
    <!-- 协议库仅依赖 BCL，保持零第三方依赖，降低维护与合规负担 -->
  </PropertyGroup>

</Project>
