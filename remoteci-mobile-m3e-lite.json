{
  "title": "RemoteCI Mobile",
  "brief": "RemoteCI 手机版：集中处理设备控制、实时查看、任务告警和人员权限。",
  "frame": "phone",
  "platform": "android",
  "paletteKey": "teal",
  "theme": { "dark": false, "bothModes": true, "contrast": "standard", "shape": "rounded", "font": "roboto", "emphasized": false, "motion": "expressive" },
  "frames": [
    { "id": "devices", "name": "设备", "x": 0, "y": 0, "note": "设备总览；按状态找到需要处置的设备。" },
    { "id": "control", "name": "设备控制", "x": 492, "y": 0, "note": "查看单台设备状态并发起受审计的远程操作。" },
    { "id": "monitor", "name": "实时监看", "x": 984, "y": 0, "note": "查看远程设备的实时画面及连接状态。" },
    { "id": "tasks", "name": "任务与告警", "x": 0, "y": 972, "note": "值班员的进行中任务、失败任务与告警队列。" },
    { "id": "team", "name": "团队与权限", "x": 492, "y": 972, "note": "管理成员、角色和可访问的设备组。" }
  ],
  "groups": [
