<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RemoteCI.Server</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- 软件版本与协议版本独立；任意 3.x.x 软件通过协议 V3 的能力协商互通。 -->
    <Version>3.2.1.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../shared/RemoteCI.Shared/RemoteCI.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RemoteCI.Server.Tests" />
  </ItemGroup>

  <!-- 旧版就地更新可能把 publish 产物留在项目根目录；这些文件即使被 Git 忽略，
       Web SDK 仍会当作内容再次打包，因此在项目层显式排除。 -->
  <ItemGroup>
    <Content Remove="RemoteCI.Server.deps.json;RemoteCI.Server.runtimeconfig.json;RemoteCI.Server.staticwebassets.endpoints.json;web.config" />
    <Content Remove="wwwroot/**/*.br;wwwroot/**/*.gz" />
    <None Remove="RemoteCI.Server.deps.json;RemoteCI.Server.runtimeconfig.json;RemoteCI.Server.staticwebassets.endpoints.json;web.config" />
    <None Remove="wwwroot/**/*.br;wwwroot/**/*.gz" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!-- 2.1.12 覆盖 EF 的易受攻击传递版本 2.1.11。 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
