@page
@model ClassesModel
@{
    ViewData["Title"] = "班级管理";
}
<div class="page-head">
    <div>
        <h1>班级管理</h1>
    </div>
</div>

<div class="class-manager">
    <aside class="panel class-tree-panel">
        <div class="class-tree-head">
            <div>
                <h2>班级分组</h2>
                <p class="muted">分组可多层嵌套，一个班级可属于多个分组。</p>
            </div>
        </div>
        <nav class="class-tree" aria-label="班级分组树">
            <ul class="class-tree-root">
                <li class="class-tree-item">
                    <div class="class-tree-row @(Model.SelectedGroupId is null ? "active" : null)">
                        <span class="tree-toggle-placeholder" aria-hidden="true"></span>
                        <i class="bi bi-collection tree-icon" aria-hidden="true"></i>
                        <a class="tree-label" href="@Url.Page("/Classes")">全部班级</a>
                        <span class="tree-count">@Model.Classes.Count</span>
                        <span class="tree-menu-spacer" aria-hidden="true"></span>
                    </div>
                </li>
                <li class="class-tree-item">
                    <div class="class-tree-row @(Model.IsUngroupedSelected ? "active" : null)">
                        <span class="tree-toggle-placeholder" aria-hidden="true"></span>
                        <i class="bi bi-inbox tree-icon" aria-hidden="true"></i>
                        <a class="tree-label" href="@Url.Page("/Classes", new { groupId = ClassesModel.UnassignedGroupId })">未分组</a>
                        <span class="tree-count">@Model.UnassignedClassCount</span>
                        <span class="tree-menu-spacer" aria-hidden="true"></span>
                    </div>
                </li>
                @foreach (var node in Model.GroupTree)
                {
                    <partial name="_ClassGroupTreeNode" model="node" />
                }
            </ul>
            @if (Model.Groups.Count == 0)
            {
                <p class="class-tree-empty muted">还没有分组。可以先创建学校、年级或校区节点。</p>
            }
        </nav>
        <details class="class-tree-create">
            <summary><i class="bi bi-plus-lg" aria-hidden="true"></i>新建分组</summary>
            <form method="post" asp-page="/Classes" asp-page-handler="CreateGroup">
                <input type="hidden" name="groupId" value="@Model.SelectedGroupId" />
                <label>分组名称<input asp-for="NewGroupName" required maxlength="40" placeholder="例如：高一年级" /></label>
                <label>上级分组
                    <select name="parentGroupId">
                        <option value="">（根分组）</option>
                        @foreach (var group in Model.Groups)
                        {
                            <option value="@group.Id" selected="@(group.Id == Model.SelectedGroupId)">@(string.Concat(Enumerable.Repeat("　", Math.Max(0, group.Depth - 1))) + group.Name)</option>
                        }
                    </select>
                </label>
                <button type="submit">创建分组</button>
            </form>
        </details>
    </aside>

    <section class="panel class-content-panel">
        <div class="class-content-head">
            <div>
                <p class="eyebrow">当前范围</p>
                <h2>@Model.ScopeTitle</h2>
                <p class="muted">@Model.ScopeDescription</p>
            </div>
            <div class="class-content-actions">
                <details class="inline-create">
                    <summary class="button"><i class="bi bi-plus-lg" aria-hidden="true"></i>新建班级</summary>
                    <form method="post" asp-page="/Classes" asp-page-handler="Create" class="floating-form">
                        <input type="hidden" name="groupId" value="@Model.SelectedGroupId" />
                        <label>班级名称<input asp-for="NewClassName" required maxlength="40" placeholder="例如：高一（1）班" /></label>
                        <label>固定配对码（可选）<input asp-for="NewClassPairCode" maxlength="64" placeholder="留空则不设置；6-64 位不含空格" /></label>
                        <p class="muted">插件用固定配对码连接后自动绑定到本班。每个班级只保留一台设备，新设备会顶替旧设备。</p>
                        <button type="submit">创建班级</button>
                    </form>
                </details>
            </div>
        </div>

        <div class="class-metrics" aria-label="当前范围统计">
            <div><span>班级</span><strong>@Model.VisibleClasses.Count</strong></div>
            <div><span>访客已开</span><strong>@Model.VisitorClassCount</strong></div>
            <div><span>插件在线</span><strong>@Model.OnlineClassCount</strong></div>
        </div>

        @if (Model.Classes.Count == 0)
        {
            <div class="notice warning class-content-empty">还没有班级。请先创建班级，再按分组组织。</div>
        }
        else
        {
            <form id="batch-form" method="post" asp-page="/Classes" asp-page-handler="Batch" class="class-batch-bar" data-class-batch-form>
                <input type="hidden" name="groupId" value="@Model.SelectedGroupId" />
                <label>批量操作
                    <select asp-for="BatchOperation" data-batch-operation required>
                        <option value="enableVisitor">批量开启访客</option>
                        <option value="disableVisitor">批量关闭访客</option>
                        @if (Model.Groups.Count > 0)
                        {
                            <option value="addGroups">批量加入分组</option>
                            <option value="removeGroups">批量移出分组</option>
                            <option value="replaceGroups">批量设置为所选分组</option>
                            <option value="clearGroups">批量清空分组</option>
                        }
                        <option value="delete">批量删除班级</option>
                    </select>
                </label>
                @if (Model.Groups.Count > 0)
                {
                    <div class="batch-group-target" data-batch-group-field>
                        <label>目标分组
                            <select asp-for="BatchTargetGroupIds" multiple size="@(Math.Min(6, Math.Max(2, Model.Groups.Count)))" data-batch-group-select>
                                @foreach (var group in Model.Groups)
                                {
                                    <option value="@group.Id">@(string.Concat(Enumerable.Repeat("　", Math.Max(0, group.Depth - 1))) + group.Name)</option>
                                }
                            </select>
                        </label>
                    </div>
                }
                <div class="batch-actions">
                    <button type="submit" data-batch-submit>执行批量操作</button>
                    <span class="batch-selection" data-batch-selection>已选 0 个班级</span>
                </div>
            </form>

            @if (Model.VisibleClasses.Count == 0)
            {
                <div class="empty-state class-content-empty">
                    <i class="bi bi-diagram-3" aria-hidden="true"></i>
                    <strong>当前分组暂无班级</strong>
                    <span>可在左侧切换范围，或把班级批量加入此分组。</span>
                </div>
            }
            else
            {
                <div class="user-account-table-wrap class-table-wrap">
                    <table class="user-account-table class-table">
                        <thead>
                            <tr>
                                <th scope="col"><input type="checkbox" data-select-all-classes aria-label="全选当前范围班级" /></th>
                                <th scope="col">班级</th>
                                <th scope="col">分组</th>
                                <th scope="col">成员</th>
                                <th scope="col">插件</th>
                                <th scope="col">访客</th>
                                <th scope="col"><span class="visually-hidden">操作</span></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var classroom in Model.VisibleClasses)
                        {
                            var members = Model.MembersByClass.GetValueOrDefault(classroom.Id, Array.Empty<ClassMemberInfo>());
                            <tr>
                                <td data-label="选择">
                                    <input type="checkbox" name="SelectedClassIds" value="@classroom.Id" form="batch-form"
                                           data-class-select
                                           data-default-class="@(classroom.Id == Classroom.DefaultId ? "true" : "false")"
                                           aria-label="选择 @classroom.Name" />
                                </td>
                                <td data-label="班级">
                                    <div class="class-name-cell">
                                        <strong>@classroom.Name</strong>
                                        @if (classroom.Id == Classroom.DefaultId)
                                        {
                                            <span class="muted">默认班级</span>
                                        }
                                    </div>
                                </td>
                                <td data-label="分组">
                                    @if (classroom.GroupNames is { Count: > 0 })
                                    {
                                        for (var i = 0; i < classroom.GroupNames.Count; i++)
                                        {
                                            var groupId = classroom.GroupIds?.ElementAtOrDefault(i);
                                            if (groupId is Guid id)
                                            {
                                                <a class="group-name" href="@Url.Page("/Classes", new { groupId = id })">@classroom.GroupNames[i]</a>
                                            }
                                            else
                                            {
                                                <span class="group-name">@classroom.GroupNames[i]</span>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <span class="muted">未分组</span>
                                    }
                                </td>
                                <td data-label="成员">@classroom.MemberCount</td>
                                <td data-label="插件">
                                    <span class="status-pill @(classroom.PluginCount > 0 ? "online" : "offline")">@(classroom.PluginCount > 0 ? "在线" : "离线")</span>
                                    <small class="muted">配对码：@(classroom.HasPairingCode ? "已设置" : "未设置")</small>
                                </td>
                                <td data-label="访客">
                                    <span class="status-pill @(classroom.VisitorEnabled ? "online" : "offline")">@(classroom.VisitorEnabled ? "已开启" : "已关闭")</span>
                                </td>
                                <td data-label="操作">
                                    <details class="row-menu">
                                        <summary aria-label="管理 @classroom.Name"><i class="bi bi-three-dots" aria-hidden="true"></i></summary>
                                        <div class="row-menu-panel">
                                            @if (classroom.Id != Classroom.DefaultId)
                                            {
                                                <form method="post" asp-page="/Classes" asp-page-handler="Rename" class="row-menu-form">
                                                    <input type="hidden" name="id" value="@classroom.Id" />
                                                    <input type="hidden" name="groupId" value="@Model.SelectedGroupId" />
                                                    <label>班级名称<input type="text" name="name" value="@classroom.Name" required maxlength="40" /></label>
                                                    <button type="submit" class="ghost">保存名称</button>
                                                </form>
                                            }
                                            <form method="post" asp-page="/Classes" asp-page-handler="ToggleVisitor" class="row-menu-form">
                                                <input type="hidden" name="id" value="@classroom.Id" />
                                                <input type="hidden" name="groupId" value="@Model.SelectedGroupId" />
                                                <input type="hidden" name="enabled" value="@(classroom.VisitorEnabled ? "false" : "true")" />
                                                <button type="submit" class="ghost">@(classroom.VisitorEnabled ? "关闭访客" : "开启访客")</button>
                                            </form>
                                            <form method="post" asp-page="/Classes" asp-page-handler="SetClassPairCode" class="row-menu-form">
                                                <input type="hidden" name="id" value="@classroom.Id" />
                                                <input type="hidden" name="groupId" value="@Model.SelectedGroupId" />
                                                <label>固定配对码（留空自动生成）<input type="text" name="ClassPairCodeInput" maxlength="64" placeholder="@(classroom.HasPairingCode ? "已设置；输入新值可重置" : "未设置")" /></label>
                                                <button type="submit" class="ghost">@(classroom.HasPairingCode ? "重置配对码" : "设置配对码")</button>
                                            </form>
                                            @if (Model.GeneratedPairCode is { } generatedCode && Model.GeneratedPairCodeClassId == classroom.Id)
                                            {
                                                <p class="notice ok row-menu-note">新配对码：<code>@generatedCode</code>（仅本次显示，请立即记录）</p>
                                            }
                                            @if (classroom.Id == Classroom.DefaultId)
                                            {
                                                <p class="muted row-menu-note">默认班级不可删除。</p>
                                            }
                                            else
                                            {
                                                <form method="post" asp-page="/Classes" asp-page-handler="Delete" class="row-menu-form" onsubmit="return confirm('删除班级会同时移除成员关系与插件凭据，需重新配对。确定继续？')">
                                                    <input type="hidden" name="id" value="@classroom.Id" />
                                                    <input type="hidden" name="groupId" value="@Model.SelectedGroupId" />
                                                    <button type="submit" class="danger ghost">删除班级</button>
                                                </form>
                                            }
                                        </div>
                                    </details>
                                </td>
                            </tr>
                            <tr class="member-row">
                                <td></td>
                                <td colspan="6">
                                    <details class="member-details">
                                        <summary>成员（@members.Count）</summary>
                                        <ul class="member-list">
                                            @foreach (var member in members)
                                            {
                                                <li>
                                                    <span>@member.DisplayName（@member.Username）· @member.RoleName</span>
                                                    <form method="post" asp-page="/Classes" asp-page-handler="RemoveMember" class="inline-form">
                                                        <input type="hidden" name="id" value="@classroom.Id" />
                                                        <input type="hidden" name="userId" value="@member.UserId" />
                                                        <input type="hidden" name="groupId" value="@Model.SelectedGroupId" />
                                                        <button type="submit" class="ghost">移出</button>
                                                    </form>
                                                </li>
                                            }
                                            @if (members.Count == 0)
                                            {
                                                <li class="muted">暂无成员。</li>
                                            }
                                        </ul>
                                        @if (Model.Accounts.Any(x => x.Enabled && members.All(m => m.UserId != x.Id)))
                                        {
                                            <form method="post" asp-page="/Classes" asp-page-handler="AddMember" class="inline-form member-add-form">
                                                <input type="hidden" name="id" value="@classroom.Id" />
                                                <input type="hidden" name="groupId" value="@Model.SelectedGroupId" />
                                                <select name="userId" required aria-label="选择用户">
                                                    @foreach (var account in Model.Accounts.Where(x => x.Enabled && members.All(m => m.UserId != x.Id)))
                                                    {
                                                        <option value="@account.Id">@account.DisplayName（@account.Username）</option>
                                                    }
                                                </select>
                                                <select name="roleId" required aria-label="选择角色">
                                                    @foreach (var role in Model.RoleDefinitions.Where(x => x.Kind != nameof(AccountRoleKind.Administrator)))
                                                    {
                                                        <option value="@role.Id">@role.Name</option>
                                                    }
                                                </select>
                                                <button type="submit">添加成员</button>
                                            </form>
                                        }
                                    </details>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        }
    </section>
</div>


@if (Model.CurrentUser.Role == UserRole.Admin)
{
<section class="panel class-self-service-panel" id="class-self-service">
    <div class="panel-heading">
        <div>
            <h2>班主任权限</h2>
            <p class="muted">统一决定班主任能否在自己的班级里自行完成以下操作，对全部班级生效；系统管理员始终可以执行。</p>
        </div>
    </div>
    <form method="post" asp-page-handler="SaveSelfService" class="stack">
        <input type="hidden" name="groupId" value="@Model.SelectedGroupId" />
        <fieldset class="batch-check-group">
            <legend>允许班主任</legend>
            <label class="check"><input type="checkbox" name="SelfServiceOptions.CanRename" value="true" checked="@Model.SelfServicePolicy.CanRename" /> 修改本班班名</label>
            <label class="check"><input type="checkbox" name="SelfServiceOptions.CanChangeAvatar" value="true" checked="@Model.SelfServicePolicy.CanChangeAvatar" /> 上传或清除本班头像</label>
            <label class="check"><input type="checkbox" name="SelfServiceOptions.CanPullSchedule" value="true" checked="@Model.SelfServicePolicy.CanPullSchedule" /> 手动从插件拉取本班课表</label>
            <label class="check"><input type="checkbox" name="SelfServiceOptions.CanEditExtensionSettings" value="true" checked="@Model.SelfServicePolicy.CanEditExtensionSettings" /> 修改本班的扩展插件设置</label>
        </fieldset>
        <p class="muted">关闭“修改本班的扩展插件设置”后，扩展设置只能由系统管理员在“扩展插件”页统一下发。课表定时拉取间隔属于全局设置，始终只有系统管理员可以修改。</p>
        <div><button type="submit">保存班主任权限</button></div>
    </form>
</section>
}

@if (Model.CurrentUser.Role == UserRole.Admin)
{
<section class="panel member-excel-panel pairing-panel">
    <div class="panel-heading">
        <div>
            <h2>连接码与设备分配</h2>
            <p class="muted">班级固定配对码：插件连接后自动绑定到对应班级。统一连接码：可接入多台设备，设备先进入“未分配”，指派班级后才能操控。</p>
        </div>
        <span class="status-pill @(Model.HasUnifiedCode ? "online" : "offline")">统一连接码@(Model.HasUnifiedCode ? "已设置" : "未设置")</span>
    </div>
    <div class="member-excel-grid">
        <article class="member-excel-card">
            <h3>统一连接码</h3>
            <p>插件端可填写班级名备注，便于指派。重新保存会替换旧的统一连接码。</p>
            <form method="post" asp-page-handler="SetUnifiedCode" class="stack">
                <input type="hidden" name="groupId" value="@Model.SelectedGroupId" />
                <label>自定义连接码（留空自动生成）<input asp-for="UnifiedPairCodeInput" maxlength="64" placeholder="6-64 位，不含空格" /></label>
                <button type="submit">@(Model.HasUnifiedCode ? "替换统一连接码" : "设置统一连接码")</button>
            </form>
        </article>
        <article class="member-excel-card pairing-unassigned-card">
            <h3>未分配设备（@Model.UnassignedDevices.Count）</h3>
            @if (Model.UnassignedDevices.Count == 0)
            {
                <p class="muted">暂无未分配设备。</p>
            }
            else
            {
                <ul class="pairing-device-list">
                    @foreach (var device in Model.UnassignedDevices)
                    {
                        <li class="pairing-device">
                            <div class="pairing-device-head">
                                <strong>@device.DeviceName</strong>
                                <span class="status-pill @(device.Online ? "online" : "offline")">@(device.Online ? "在线" : "离线")</span>
                            </div>
                            <small class="muted">班级备注：@(string.IsNullOrWhiteSpace(device.Remark) ? "未填写" : device.Remark)</small>
                            <div class="pairing-device-actions">
                                <form method="post" asp-page-handler="AssignDevice" class="inline-form">
                                    <input type="hidden" name="credentialId" value="@device.CredentialId" />
                                    <input type="hidden" name="groupId" value="@Model.SelectedGroupId" />
                                    <select name="AssignDeviceClassId" required aria-label="指派到班级">
                                        <option value="">选择班级…</option>
                                        @foreach (var classroom in Model.Classes)
                                        {
                                            <option value="@classroom.Id">@classroom.Name</option>
                                        }
                                    </select>
                                    <button type="submit" class="ghost">指派</button>
                                </form>
                                <form method="post" asp-page-handler="RevokeUnassigned" class="inline-form" onsubmit="return confirm('移除后该设备需重新使用连接码接入。确定？')">
                                    <input type="hidden" name="credentialId" value="@device.CredentialId" />
                                    <input type="hidden" name="groupId" value="@Model.SelectedGroupId" />
                                    <button type="submit" class="danger ghost">移除</button>
                                </form>
                            </div>
                        </li>
                    }
                </ul>
            }
        </article>
    </div>
</section>
}

@if (Model.CurrentUser.Role == UserRole.Admin)
{
<section class="panel member-excel-panel">
    <div class="panel-heading">
        <div>
            <h2>批量导入与导出</h2>
            <p class="muted">普通导入只新建；覆盖导入使用 RemoteCI 导出的 Excel，只新增与修改，不会删除班级或分组。</p>
        </div>
    </div>
    <div class="member-excel-grid">
        <article class="member-excel-card">
            <h3>1. 下载模板</h3>
            <p>模板包含“分组”和“班级”两个工作表。分组可用“上级分组”建立层级；班级可填写多个分组，用分号“;”分隔。</p>
            <a class="button" asp-page-handler="Template">下载 Excel 模板</a>
        </article>
        <article class="member-excel-card">
            <h3>2. 导入新建</h3>
            <p>填写模板后上传。名称已存在、上级分组缺失、层级超限或字段非法会逐条列出，其他合法行仍会创建。</p>
            <form method="post" asp-page-handler="ImportExcel" enctype="multipart/form-data" class="stack">
                <input type="hidden" name="groupId" value="@Model.SelectedGroupId" />
                <label>填写后的 Excel<input type="file" name="excelFile" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required /></label>
                <button type="submit">上传并导入</button>
            </form>
        </article>
        <article class="member-excel-card">
            <h3>3. 导出并覆盖修改</h3>
            <p>导出所选范围内的班级和全部分组，修改名称、分组归属或访客开关后上传同一文件覆盖。</p>
            <form method="get" asp-page-handler="Export" class="stack">
                <label>导出范围
                    <select name="groupId">
                        <option value="">全部班级</option>
                        @foreach (var group in Model.Groups)
                        {
                            <option value="@group.Id">@(string.Concat(Enumerable.Repeat("　", Math.Max(0, group.Depth - 1))) + group.Name)</option>
                        }
                    </select>
                </label>
                <button type="submit">导出 Excel</button>
            </form>
            <form method="post" asp-page-handler="OverwriteExcel" enctype="multipart/form-data" class="stack">
                <input type="hidden" name="groupId" value="@Model.SelectedGroupId" />
                <label>修改后的导出文件<input type="file" name="excelFile" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required /></label>
                <button type="submit" class="ghost" onclick="return confirm('覆盖导入会更新已有的班级与分组并新增行，不会删除。确定继续吗？')">上传并覆盖</button>
            </form>
        </article>
    </div>

    @if (Model.ExcelImportResult is { } report)
    {
        <div class="member-import-result">
            <div class="notice @(report.HasFailures ? "warning" : "ok")">
                <div>
                    <strong>@(report.Overwrite ? "覆盖导入结果" : "导入结果")</strong>
                    <span>@report.Summary</span>
                </div>
            </div>
            @if (report.HasFailures)
            {
                <div class="user-account-table-wrap member-import-failures">
                    <table class="user-account-table">
                        <thead><tr><th scope="col">工作表</th><th scope="col">Excel 行</th><th scope="col">名称</th><th scope="col">失败原因</th></tr></thead>
                        <tbody>
                        @foreach (var failure in report.Failures)
                        {
                            <tr>
                                <td data-label="工作表">@failure.Sheet</td>
                                <td data-label="Excel 行">@failure.RowNumber</td>
                                <td data-label="名称"><code>@failure.Name</code></td>
                                <td data-label="失败原因">@failure.Message</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</section>
}
