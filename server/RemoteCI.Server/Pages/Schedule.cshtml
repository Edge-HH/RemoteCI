@page
@model ScheduleModel
@{ ViewData["Title"] = "课表"; }
<div class="page-head"><div><p class="eyebrow">指定日期课表</p><h1>未来七日课表</h1></div><span class="status @(Model.PluginOnline ? "online" : "offline")">@(Model.PluginOnline ? "已连接" : "插件离线")</span></div>
@if (Model.CanPullSchedule)
{
<section class="panel schedule-pull-panel">
    <form method="post" asp-page-handler="Pull" class="schedule-pull-layout" data-schedule-pull-form>
        <div class="schedule-pull-copy"><h2>从插件拉取课表</h2><p class="muted">立即连接在线插件重新生成当前课表；拉取成功后会强制覆盖服务端缓存。</p></div>
        <button type="submit" class="schedule-pull-button" disabled="@(!Model.PluginOnline || Model.CurrentTask is not null)" data-schedule-pull-button>@(Model.CurrentTask is null ? "立即拉取课表" : "已有课表任务正在执行")</button>
        @if (Model.CurrentTask is { } task)
        {
            <div class="schedule-pull-progress" data-schedule-pull-progress aria-live="polite"><progress></progress><span>@task.Message，请勿重复操作。</span></div>
        }
        else
        {
            <div class="schedule-pull-progress" data-schedule-pull-progress hidden aria-live="polite"><progress></progress><span>正在连接插件并拉取课表，请稍候…</span></div>
        }
    </form>
</section>
}
@if (Model.Bundle is null)
{
    <div class="notice warning">插件尚未同步课表。</div>
}
else
{
    var courseOptions = Model.Bundle.Days
        .Where(day => day.Enabled)
        .SelectMany(day => day.Courses
            .Where(course => course.Enabled)
            .Select(course => new
            {
                day.Date,
                day.Revision,
                course.Index,
                Label = $"{day.Date} · {course.Label} · {course.Subject}",
            }))
        .ToList();
    <partial name="_ScheduleTable" model="Model.Bundle" />
    @if (Model.CanManageSchedule)
    {
    <section class="panel">
        <h2>提交修改</h2>
        <form method="post" class="form-grid schedule-change-form" data-schedule-change-form>
            <label>日期与原节次
                <select data-schedule-source required>
                    @{ var sourceOptionIndex = 0; }
                    @foreach (var option in courseOptions)
                    {
                        <option value="@sourceOptionIndex" data-date="@option.Date" data-revision="@option.Revision" data-index="@option.Index">@option.Label</option>
                        sourceOptionIndex++;
                    }
                </select>
                <input asp-for="Input.Date" type="hidden" data-schedule-source-date />
                <input asp-for="Input.ExpectedRevision" type="hidden" data-schedule-source-revision />
                <input asp-for="Input.SourceIndex" type="hidden" data-schedule-source-index />
            </label>
            <label>模式
                <select asp-for="Input.Mode" data-schedule-mode>
                    <option value="Exchange">交换</option>
                    <option value="Replace">替换</option>
                </select>
            </label>
            <label data-exchange-field>日期与目标节次
                <select asp-for="Input.TargetIndex" data-schedule-target required>
                    <option value="">请选择目标日期与节次</option>
                    @foreach (var option in courseOptions)
                    {
                        <option value="@option.Index" data-date="@option.Date" data-index="@option.Index">@option.Label</option>
                    }
                </select>
            </label>
            <label data-replace-field hidden>替换科目
                <select asp-for="Input.ReplacementSubjectId" disabled>
                    <option value="">不选择</option>
                    @foreach (var subject in Model.Bundle.Subjects)
                    {
                        <option value="@subject.Id">@subject.Name</option>
                    }
                </select>
            </label>
            <button type="submit" class="schedule-submit-button" disabled="@(!Model.PluginOnline)">执行并等待真实回执</button>
        </form>
    </section>
    }
}
@if (Model.CanConfigureSchedulePull)
{
<section class="panel">
    <h2>自动拉取课表</h2>
    <p class="muted">插件每次连接时都会自动拉取；这里可额外设置在线期间的刷新周期。</p>
    <form method="post" asp-page-handler="PullInterval" class="form-grid">
        <label>拉取间隔
            <select asp-for="PullInterval">
                <option value="0">关闭</option>
                <option value="15">每 15 分钟</option>
                <option value="60">每小时</option>
                <option value="360">每 6 小时</option>
                <option value="1440">每天</option>
            </select>
        </label>
        <button type="submit">保存间隔</button>
    </form>
</section>
}
