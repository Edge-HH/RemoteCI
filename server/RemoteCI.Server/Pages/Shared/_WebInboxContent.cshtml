@model InboxModel
@{
    ViewData["Title"] = "通知";
}

<div class="page-head">
    <div>
        <p class="eyebrow">个人</p>
        <h1>通知</h1>
        <p class="muted">自定义课程提醒、换课申请与审批结果。</p>
    </div>
    <form method="post" asp-page-handler="ReadAll">
        <button type="submit" class="ghost" disabled="@(!Model.Items.Any(x => x.ReadAt is null))">全部标为已读</button>
    </form>
</div>

<section class="panel push-settings" data-push-settings data-vapid-key="@Model.VapidPublicKey"
         data-subscribe-url="@Url.Page("/Inbox", "Subscribe")" data-unsubscribe-url="@Url.Page("/Inbox", "Unsubscribe")">
    @Html.AntiForgeryToken()
    <div>
        <h2>系统通知</h2><p data-ios-push-guide hidden>iPhone 请先在 Safari 分享菜单添加到主屏幕，再从桌面图标打开并开启通知。</p>
        <p class="muted" data-push-status>开启后，即使关闭网页也会在系统通知中心收到课程和换课提醒。</p>
    </div>
    <div class="push-actions">
        <button type="button" data-push-test>发送测试通知</button><button type="button" data-push-enable hidden>开启浏览器通知</button>
        <button type="button" class="ghost" data-push-disable hidden>关闭本浏览器通知</button>
    </div>
@if (MobileUi.IsMobile(Context))
{
    <fieldset class="mobile-notification-options"><legend>当前班级的课堂通知</legend>
    @foreach (var entry in new[] { (1, "上课"), (2, "下课"), (4, "放学"), (8, "课表变更"), (16, "自定义消息"), (32, "自动化"), (64, "第三方插件") })
    { <label class="check"><input type="checkbox" data-push-event value="@entry.Item1" checked="@((Model.PushEventMask & entry.Item1) != 0)" />@entry.Item2</label> }
    </fieldset><p class="muted">课堂通知跟随本浏览器最后选择的班级；个人课程和换课提醒按账号接收。</p>
}
</section>

<section class="panel">
    @if (Model.Items.Count == 0)
    {
        <p class="muted">暂时没有通知。</p>
    }
    <ul class="inbox-list">
        @foreach (var item in Model.Items)
        {
            <li class="inbox-item@(item.ReadAt is null ? " unread" : "")">
                <a href="@(item.Kind.StartsWith("personal_course_") ? Url.Page("/MySchedule") : item.SwapRequestId is null ? "#" : Url.Page("/SwapRequests") + InboxModel.SwapTab(item.Kind))" data-inbox-read="@item.Id">
                    <strong>@item.Title</strong>
                    <span class="inbox-body">@item.Body</span>
                    <time class="muted" datetime="@item.CreatedAt.ToString("O")">@InboxModel.Ago(item.CreatedAt)</time>
                </a>
            </li>
        }
    </ul>
</section>
