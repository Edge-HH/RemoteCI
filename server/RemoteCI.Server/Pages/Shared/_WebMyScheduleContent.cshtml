@model MyScheduleModel
@{
    ViewData["Title"] = "我的日程";
}

@if (MobileUi.IsMobile(Context)) { <div class="mobile-segments"><a href="/Mobile/Schedule">班级课表</a><a href="/Mobile/MySchedule" class="active">我的日程</a></div><a class="button ghost" href="/Mobile/Calendar">订阅系统日历</a> }
<div class="page-head">
    <div>
        <p class="eyebrow">个人安排</p>
        <h1>我的日程</h1>
        <p class="muted">任教课程和仅自己可见的自定义课程，自动同步到此账号的所有设备。</p>
    </div>
</div>

@if (Model.Error is not null) { <div class="notice warning" role="alert">@Model.Error</div> }
@if (Model.MonthLessons is { } lessons)
{
    <div class="notice ok my-lessons">本月已上 <strong>@lessons.Total</strong> 节课@(lessons.Substitute > 0 ? $"，其中代课 {lessons.Substitute} 节" : "")@(lessons.Substituted > 0 ? $"，被代课 {lessons.Substituted} 节" : "")。</div>
}
<section class="panel" id="personal-courses">
    <div class="panel-heading">
        <div>
            <h2>自定义课程</h2>
            <p class="muted">@(Model.Courses.Count == 0 ? "还没有自定义课程。" : $"共 {Model.Courses.Count} 门，仅自己可见。单双周课程本周可能不出现在下方日程里，可在这里统一修改。")</p>
        </div>
        @if (Model.Editing is null)
        {
            <button type="button" data-user-edit-open="personal-course-editor" aria-controls="personal-course-editor">添加自定义课程</button>
        }
        else
        {
            <a class="button" asp-page="/MySchedule" asp-route-add="true">添加自定义课程</a>
        }
    </div>
    @if (Model.Courses.Count > 0)
    {
        <div class="user-account-table-wrap">
            <table class="user-account-table personal-course-table">
                <thead><tr><th scope="col">课程</th><th scope="col">时间</th><th scope="col">地点</th><th scope="col">提醒</th><th scope="col"><span class="visually-hidden">操作</span></th></tr></thead>
                <tbody>
                @foreach (var course in Model.SortedCourses)
                {
                    <tr>
                        <td data-label="课程"><strong>@course.Subject</strong></td>
                        <td data-label="时间">@course.Summary</td>
                        <td data-label="地点">@(string.IsNullOrWhiteSpace(course.Location) ? "—" : course.Location)</td>
                        <td data-label="提醒" class="muted">@(course.ReminderMinutes is { } minutes ? $"提前 {minutes} 分钟" : "课前不提醒") · @(course.NotifyAtStart ? "上课提醒" : "上课不提醒")</td>
                        <td class="user-account-action personal-course-actions">
                            <a class="button ghost" asp-page="/MySchedule" asp-route-edit="@course.Id">修改</a>
                            <form method="post" asp-page-handler="Delete" onsubmit="return confirm('确定删除这门自定义课程？')"><input type="hidden" name="id" value="@course.Id" /><button type="submit" class="ghost danger">删除</button></form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    <p class="muted">提醒会发送到个人通知；可在<a asp-page="/Inbox">通知页</a>开启浏览器推送。已绑定的 AstrBot 可推送课程提醒。</p>
</section>

<dialog id="personal-course-editor" class="user-edit-dialog" data-user-edit-dialog data-personal-editor data-auto-open="@(Model.OpenEditor ? "true" : "false")" aria-labelledby="personal-course-editor-title">
    <div class="user-edit-dialog-shell">
        <header class="user-edit-dialog-header"><div><p class="eyebrow">自定义课程</p><h2 id="personal-course-editor-title">@(Model.Editing is null ? "添加自定义课程" : "修改自定义课程")</h2></div><button type="button" class="ghost dialog-close-button" data-user-edit-close aria-label="关闭"><i class="icon icon-close" aria-hidden="true"></i></button></header>
        <form method="post" asp-page-handler="Save" class="stack personal-course-dialog-form" data-personal-course-form>
            @if (Model.Error is not null) { <div class="notice warning" role="alert">@Model.Error</div> }
            <partial name="_PersonalCourseFields" model="Model" />
            <div class="dialog-actions"><button type="button" class="ghost" data-user-edit-close>取消</button><button type="submit">保存课程</button></div>
        </form>
    </div>
</dialog>

@if (Model.Schedule.Days.Count == 0)
{
    <div class="notice warning">
        暂无课程。可在上方添加自定义课程；任教课程按账号显示名匹配课表中的教师名。
    </div>
}

else
{
    @if (Model.Schedule.Days.Any(day => day.Items.Any(item => item.Source == RemoteCI.Shared.Models.ScheduleBundleSources.Profile)))
    {
        <div class="notice">标有“按档案推算”的班级尚未连接过教室端插件，课程按该班当前档案推算，可能与教室端实际课表不同；插件同步后自动改用实际课表。</div>
    }
    <div class="my-schedule-list" data-offline-schedule>
        @foreach (var day in Model.Schedule.Days)
        {
            <section class="panel my-schedule-day">
                <div class="panel-heading">
                    <div>
                        <h2>@MyScheduleModel.FormatDate(day.Date)</h2>
                    </div>
                    <span class="muted">@day.Items.Sum(item => item.Courses.Count) 节</span>
                </div>
                <div class="my-schedule-classes">
                    @foreach (var item in day.Items)
                    {
                        <article class="my-schedule-class">
                            <h3>@item.ClassName @if (item.Source == RemoteCI.Shared.Models.ScheduleBundleSources.Profile) { <span class="role-badge muted">按档案推算</span> }</h3>
                            <div class="my-schedule-courses">
                                @foreach (var course in item.Courses)
                                {
                                    <div class="my-schedule-course">
                                        <span class="my-schedule-course-index">@course.Label</span>
                                        <strong>@course.Subject</strong>
                                        <span class="my-schedule-course-time">@(course.StartTime ?? "—")–@(course.EndTime ?? "—")</span>
                                        @if (course.PersonalCourseId is { } personalId) { <a asp-page="/MySchedule" asp-route-edit="@personalId">修改</a> }
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </div>
}
<script src="~/js/personal-schedule.js" asp-append-version="true" defer></script>
