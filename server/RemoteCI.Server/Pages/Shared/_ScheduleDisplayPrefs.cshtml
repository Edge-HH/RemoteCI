@* 在表格渲染前读取本机的课表显示设置，写到 <html> 的 data-sg-* 属性上，避免先显示再隐藏的闪烁。键与 js/schedule-grid.js 一致。 *@
<script>try { const p = JSON.parse(localStorage.getItem("remoteci-schedule-display") || "{}"), r = document.documentElement; r.dataset.sgTeacher = p.teacher === false ? "off" : "on"; r.dataset.sgClass = p.cls === false ? "off" : "on"; r.dataset.sgLocation = p.location === false ? "off" : "on"; r.dataset.sgMerge = p.merge === false ? "off" : "on"; r.dataset.sgWeekend = p.weekend === "always" || p.weekend === "never" ? p.weekend : "auto"; if (localStorage.getItem("remoteci-myschedule-view") === "list") r.dataset.myView = "list"; } catch { }</script>
