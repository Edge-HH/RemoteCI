@if (Model.CanUseOperation(BatchOperationKind.JoinManagement))
{
<dialog id="batch-settings-join-management" class="batch-dialog batch-dialog-wide" data-batch-settings="JoinManagement" data-batch-title="加入集控" data-batch-risk="true">
    <div class="batch-dialog-shell">
        <header class="batch-dialog-header">
            <div><span class="batch-step">第 1 步 / 共 2 步</span><h2>加入 ClassIsland 内置集控</h2><p class="muted">设备加入后会按集控服务器下发的档案、策略和凭据重启生效。</p></div>
            <button type="button" class="dialog-close-button ghost" data-batch-close aria-label="关闭">×</button>
        </header>
        <div class="batch-dialog-body stack">
            <label>选择集控配置文件<input type="file" accept=".json,application/json" data-management-preset-file /></label>
            <label>集控配置文件 JSON<textarea name="ManagementPresetJson" rows="8" placeholder="粘贴 ClassIsland 集控配置文件（ManagementPreset.json），或选择文件后自动填入"></textarea></label>
            <p class="muted">配置文件为 ClassIsland 的 ManagementPreset.json（加入集控弹窗使用的配置）。设备 ID 会自动使用所选班级名，无需手动填写；加入集控会清空设备上已有的集控档案缓存，并自动重启 ClassIsland。</p>
        </div>
        <footer class="batch-dialog-actions">
            <button type="button" class="ghost" data-batch-close>取消</button>
            <button type="button" data-batch-next>下一步：选择设备</button>
        </footer>
    </div>
</dialog>
}

@if (Model.CanUseOperation(BatchOperationKind.SetPluginManagementPolicy))
{
<dialog id="batch-settings-policy" class="batch-dialog" data-batch-settings="SetPluginManagementPolicy" data-batch-title="插件管理策略" data-batch-risk="true">
    <div class="batch-dialog-shell">
        <header class="batch-dialog-header">
            <div><span class="batch-step">第 1 步 / 共 2 步</span><h2>插件管理策略</h2><p class="muted">限制 RemoteCI 后续发起的远程插件安装和卸载。</p></div>
            <button type="button" class="dialog-close-button ghost" data-batch-close aria-label="关闭">×</button>
        </header>
        <div class="batch-dialog-body stack">
            <label class="check"><input type="checkbox" name="AllowRemotePluginInstall" data-batch-bool checked /> 允许 RemoteCI 远程安装插件</label>
            <label class="check"><input type="checkbox" name="AllowRemotePluginUninstall" data-batch-bool checked /> 允许 RemoteCI 远程卸载插件</label>
            <p class="batch-warning">ClassIsland 目前没有公开的宿主级“禁止本地安装/卸载插件”策略 API；此设置只约束 RemoteCI 自己发起的远程操作。</p>
        </div>
        <footer class="batch-dialog-actions">
            <button type="button" class="ghost" data-batch-close>取消</button>
            <button type="button" data-batch-next>下一步：选择设备</button>
        </footer>
    </div>
</dialog>
}

@* 第 2 步：共享目标选择弹窗。班级/分组只取该班主设备，具体设备可多选。 *@
@if (Model.HasAnyOperations)
{
<dialog id="batch-target-dialog" class="batch-dialog batch-dialog-wide" data-batch-target-dialog>
    <form method="post" id="batch-execute-form" data-batch-execute-form>
        @Html.AntiForgeryToken()
        <input type="hidden" name="Operation" data-batch-operation />
        <div data-batch-settings-payload></div>
        <div class="batch-dialog-shell">
            <header class="batch-dialog-header">
                <div><span class="batch-step">@(Model.IsSingleControl ? "确认执行" : "第 2 步 / 共 2 步")</span><h2 data-batch-target-title>@(Model.IsSingleControl ? "确认执行" : "选择设备")</h2><p class="muted" data-batch-target-description>选择要执行该功能的班级、分组或具体设备。</p></div>
                <button type="button" class="dialog-close-button ghost" data-batch-close aria-label="关闭">×</button>
            </header>
            <div class="batch-dialog-body">
                @if (!Model.IsSingleControl)
                {
                <div class="batch-target-tabs" role="tablist">
                    <button type="button" class="ghost active" data-batch-target-tab="classes">按班级 / 分组</button>
                    <button type="button" class="ghost" data-batch-target-tab="devices">按具体设备</button>
                </div>
                }
                <section data-batch-target-panel="classes">
                    @if (Model.IsSingleControl)
                    {
                        <p class="muted">此操作将执行于当前班级：<strong>@Model.CurrentClass?.Name</strong>。</p>
                    }
                    else
                    {
                    @if (Model.Groups.Count > 0)
                    {
                        <h3>整组执行</h3>
                        <div class="broadcast-targets">
                            @foreach (var group in Model.Groups)
                            {
                                <label class="check">
                                    <input type="checkbox" name="SelectedGroupIds" value="@group.Id" data-voice-query="groupIds" />
                                    @group.Name（@group.ClassCount 个班级）
                                </label>
                            }
                        </div>
                    }
                    <h3>逐班选择</h3>
                    <div class="broadcast-targets">
                        @foreach (var classroom in Model.Classes)
                        {
                            <label class="check">
                                <input type="checkbox" name="SelectedClassIds" value="@classroom.Id" data-voice-query="classIds" />
                                @classroom.Name
                                <span class="muted">@(classroom.PluginCount > 0 ? "在线" : "离线")</span>
                                @if (classroom.GroupNames is { Count: > 0 })
                                {
                                    @foreach (var groupName in classroom.GroupNames)
                                    {
                                        <span class="group-name">@groupName</span>
                                    }
                                }
                            </label>
                        }
                    </div>
                    <p class="muted">班级级选择只会投递到该班最早接入的在线设备，避免同班多设备重复执行。</p>
                    }
                </section>
                @if (!Model.IsSingleControl)
                {
                <section data-batch-target-panel="devices" hidden>
                    <div class="batch-target-toolbar">
                        <span class="muted">@Model.Devices.Count(device => device.Online) 台在线设备</span>
                        <button type="button" class="ghost" data-batch-select-online>选择全部在线设备</button>
                    </div>
                    <div class="device-upgrade-list batch-device-list">
                        @foreach (var device in Model.Devices)
                        {
                            <article class="device-upgrade-card @(device.Online ? "" : "offline")">
                                <div class="device-card-head">
                                    <label class="device-select">
                                        <input type="checkbox" name="SelectedConnectionIds" value="@device.ConnectionId" data-voice-query="connectionIds" @(device.Online ? null : "disabled") />
                                        <span class="device-icon"><i class="bi bi-pc-display" aria-hidden="true"></i></span>
                                        <span>
                                            <strong>@device.DeviceName</strong>
                                            <small>@device.ClassName · @device.ClassIslandVersion · @device.RemoteCiVersion</small>
                                        </span>
                                    </label>
                                    <div class="device-card-status">
                                        <span class="status-pill @(device.Online ? "online" : "offline")">@(device.Online ? "在线" : "离线")</span>
                                        @if (device.Plugins.Count > 0)
                                        {
                                            <span class="status-pill">@device.Plugins.Count 个插件</span>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </section>
                }
                <label class="batch-risk-confirm" data-batch-risk-confirm hidden>
                    <input type="checkbox" name="ConfirmHighRisk" value="true" />
                    我已确认该操作会影响教室端设备，并理解可能造成重启、程序替换或连接中断。
                </label>
                <p class="batch-target-feedback" data-batch-target-feedback role="status"></p>
            </div>
            <footer class="batch-dialog-actions">
                <button type="button" class="ghost" data-batch-close>取消</button>
                <button type="button" class="ghost" data-batch-back>上一步</button>
                <button type="button" data-batch-voice-send hidden>发送语音</button>
                <button type="submit" data-batch-submit>执行</button>
            </footer>
        </div>
    </form>
</dialog>
}

@* 语音录制弹窗：语音消息先录制再选目标。录制完成后由 batch-control.js 打开共享目标弹窗，
   voice-message.js 负责录音与上传，发送时读取目标弹窗里勾选的设备。 *@
@if (Model.CanUseOperation(BatchOperationKind.VoiceMessage))
{
<dialog id="batch-voice-dialog" class="batch-dialog" data-batch-voice-dialog>
    <div class="batch-dialog-shell">
        <header class="batch-dialog-header">
            <div><span class="batch-step">@(Model.IsSingleControl ? "语音消息" : "第 1 步 / 共 2 步")</span><h2>录制语音</h2><p class="muted" data-batch-voice-targets>@(Model.IsSingleControl ? "录制并试听后直接发送到当前班级。" : "先录制语音，再选择要广播的班级或设备。")</p></div>
            <button type="button" class="dialog-close-button ghost" data-batch-close aria-label="关闭">×</button>
        </header>
        <div class="batch-dialog-body">
            <form method="post" asp-page-handler="@(Model.IsSingleControl ? "SingleVoice" : "BroadcastVoice")" class="stack" data-voice-form data-worklet-url="@Url.Content("~/voice-recorder-worklet.js")">
                @Html.AntiForgeryToken()
                <div class="control-actions">
                    <button type="button" data-voice-record>开始录音</button>
                    <button type="button" class="ghost" data-voice-stop disabled>停止录音</button>
                    <button type="button" class="ghost" data-voice-discard disabled>丢弃</button>
                    @* 保留 data-voice-send：voice-message.js 用它判断是否已有可继续的录音。 *@
                    <button type="button" data-voice-send data-voice-next-to-targets disabled>@(Model.IsSingleControl ? "发送语音" : "下一步：选择设备")</button>
                </div>
                <audio controls data-voice-preview hidden aria-label="试听语音"></audio>
                <p class="control-note" data-voice-status role="status">@(Model.IsSingleControl ? "录制完成后点击“发送语音”，发送到当前班级。" : "录制完成后点击“下一步：选择设备”，再确认广播目标。")</p>
                <p class="control-note" data-voice-transport-warning hidden>（当前使用不安全的HTTP连接）</p>
            </form>
        </div>
    </div>
</dialog>
}

<template id="time-layout-row-template">
    <div class="time-layout-row">
        <input type="time" data-time-layout-start value="08:00" aria-label="开始时间" />
        <input type="time" data-time-layout-end value="08:45" aria-label="结束时间" />
        <select data-time-layout-type aria-label="时间点类型">
            <option value="0">上课</option>
            <option value="1">课间</option>
            <option value="2">分割线</option>
            <option value="3">行动</option>
        </select>
        <input type="text" data-time-layout-break maxlength="40" placeholder="可选" aria-label="课间名称" />
        <button type="button" class="ghost time-layout-remove" data-time-layout-remove aria-label="删除时间点">×</button>
    </div>
</template>

<script src="~/batch-control.js" asp-append-version="true" defer></script>
</div>
