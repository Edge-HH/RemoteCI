@model RemoteCI.Server.Pages.ClassAvatarModel
@* 班级头像：已上传时显示图片，未上传时显示统一的班级图标，避免出现空白位置。 *@
@if (Model.HasAvatar)
{
    <img class="@Model.CssClass" src="/api/classes/@Model.ClassId/avatar@(Model.Version is { } version ? $"?v={version}" : null)" alt="@Model.Alt" />
}
else
{
    <span class="@Model.CssClass class-avatar-fallback" role="img" aria-label="@(string.IsNullOrEmpty(Model.Alt) ? "班级图标" : Model.Alt)"><svg viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m6.08 9.5l-3.5 1.6a1 1 0 0 0 0 1.81l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9a1 1 0 0 0 0-1.83l-3.5-1.59"/><path d="m6.08 14.5l-3.5 1.6a1 1 0 0 0 0 1.81l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9a1 1 0 0 0 0-1.83l-3.5-1.59"/></g></svg></span>
}
