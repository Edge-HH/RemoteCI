@model ScheduleBundle
@{
    var weekNames = new[] { "周日", "周一", "周二", "周三", "周四", "周五", "周六" };
    var courseRows = Model.Days
        .SelectMany(day => day.Courses)
        .GroupBy(course => course.Index)
        .OrderBy(group => group.Key)
        .ToList();
}
<div class="schedule-table-wrap">
    <table class="schedule-table">
        <thead><tr><th scope="col" class="schedule-period-heading">节次</th>@foreach (var day in Model.Days) { var dayTitle = DateTime.TryParse(day.Date, out var parsedDate) ? weekNames[(int)parsedDate.DayOfWeek] : day.Date; <th scope="col"><strong>@dayTitle</strong><small>@day.Date</small></th> }</tr></thead>
        <tbody>
        @foreach (var row in courseRows)
        {
            var rowLabel = row.Select(course => course.Label).FirstOrDefault(label => !string.IsNullOrWhiteSpace(label)) ?? $"第 {row.Key + 1} 节";
            <tr><th scope="row" class="schedule-period-cell">@rowLabel</th>@foreach (var day in Model.Days) { var course = day.Courses.FirstOrDefault(item => item.Index == row.Key); <td>@if (day.Enabled && course is not null && course.Enabled) { <div class="schedule-course-name" title="@course.Subject">@course.Subject</div><div class="schedule-course-time" title="@($"{course.StartTime}–{course.EndTime}")">@course.StartTime–@course.EndTime</div> } else { <span class="schedule-empty">—</span> }</td> }</tr>
        }
        </tbody>
    </table>
</div>
