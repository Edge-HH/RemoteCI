@model ScheduleBundle
@{
    var weekNames = new[] { "周日", "周一", "周二", "周三", "周四", "周五", "周六" };
    // 列固定按周一到周日排列；课表是从今天起的七天，所以今天之前的星期几显示的是下周的日期。
    var today = ViewData["ScheduleToday"] as string;
    var days = Model.Days
        .Select(day => (Day: day, Parsed: DateTime.TryParse(day.Date, out var parsed) ? parsed : (DateTime?)null))
        .OrderBy(item => item.Parsed is { } date ? ((int)date.DayOfWeek + 6) % 7 : 7)
        .ThenBy(item => item.Day.Date, StringComparer.Ordinal)
        .ToList();
    var courseRows = Model.Days
        .SelectMany(day => day.Courses)
        .GroupBy(course => course.Index)
        .OrderBy(group => group.Key)
        .ToList();
}
<div class="schedule-table-wrap">
    <table class="schedule-table">
        <thead><tr><th scope="col" class="schedule-period-heading">节次</th>@foreach (var (day, parsedDate) in days) { var dayTitle = parsedDate is { } date ? weekNames[(int)date.DayOfWeek] : day.Date; var isToday = today is not null && day.Date == today; <th scope="col" class="@(isToday ? "schedule-today" : null)" aria-current="@(isToday ? "date" : null)"><strong>@dayTitle@(isToday ? "（今天）" : null)</strong><small>@day.Date</small>@if (day.DayKind == RemoteCI.Shared.Models.ScheduleDayKinds.Holiday) { <em class="schedule-day-tag holiday">放假 · @day.HolidayName</em> } else if (day.DayKind == RemoteCI.Shared.Models.ScheduleDayKinds.Makeup) { <em class="schedule-day-tag makeup">调休 · @day.HolidayName</em> }</th> }</tr></thead>
        <tbody>
        @foreach (var row in courseRows)
        {
            var rowLabel = row.Select(course => course.Label).FirstOrDefault(label => !string.IsNullOrWhiteSpace(label)) ?? $"第 {row.Key + 1} 节";
            <tr><th scope="row" class="schedule-period-cell">@rowLabel</th>@foreach (var (day, _) in days) { var course = day.Courses.FirstOrDefault(item => item.Index == row.Key); <td class="@(today is not null && day.Date == today ? "schedule-today" : null)">@if (day.Enabled && course is not null && course.Enabled) { <div class="schedule-course-name" title="@course.Subject">@course.Subject</div>@if (!string.IsNullOrWhiteSpace(course.Teacher)) { <div class="schedule-course-teacher" title="@course.Teacher">@course.Teacher</div> } <div class="schedule-course-time" title="@($"{course.StartTime}–{course.EndTime}")">@course.StartTime–@course.EndTime</div> } else { <span class="schedule-empty">—</span> }</td> }</tr>
        }
        </tbody>
    </table>
</div>
