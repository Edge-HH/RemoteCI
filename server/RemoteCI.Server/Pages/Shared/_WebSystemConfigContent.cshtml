@model SystemConfigModel
@{
    ViewData["Title"] = "系统设置";
    ViewData["SystemTab"] = "general";
}
<div class="page-head">
    <div>
        <p class="eyebrow">服务端管理</p>
        <h1>系统设置</h1>
    </div>
</div>
@await Html.PartialAsync("_SystemSettingsTabs", Model)
<section class="panel" id="organization" data-tab="general">
    <h2>组织信息</h2>
    <p class="muted">组织名（如学校名称）会显示在应用守护的恢复提示中：“当前ClassIsland由<strong>组织名</strong>统一管理”。留空时显示 RemoteCI。</p>
    <form method="post" asp-page-handler="SaveOrganization" class="stack system-config-form">
        <label>组织名<input asp-for="OrganizationName" maxlength="60" placeholder="RemoteCI" autocomplete="off" /></label>
        <button type="submit">保存组织信息</button>
    </form>
</section>

<section class="panel" id="notification-sender" data-tab="general">
    <h2>通知人显示</h2>
    <p class="muted">自定义通知的标题是否附带发送人，对所有班级生效。</p>
    <form method="post" asp-page-handler="SaveNotificationSettings" class="stack system-config-form">
        <label class="check"><input asp-for="ForceSenderInTitle" /> 强制在标题显示发送人</label>
        <button type="submit">保存通知设置</button>
    </form>
</section>

<section class="panel" id="screenshot" data-tab="general">
    <h2>屏幕截图</h2>
    <p class="muted">拥有“屏幕截图”权限的账号（系统管理员、默认的班主任角色）可在控制页获取教室电脑当前屏幕；每次截图都会写入操作记录。</p>
    <form method="post" asp-page-handler="SaveScreenshotSettings" class="stack system-config-form">
        <label class="check"><input asp-for="ScreenshotNotifyClassroom" /> 截图后在教室端提示“已远程获取本机屏幕截图”</label>
        <button type="submit">保存截图设置</button>
    </form>
</section>

<section class="panel" id="device-alerts" data-tab="general">
    <h2>集控运维</h2>
    <p class="muted">设备离线告警推送给系统管理员和该班班主任（个人通知、浏览器推送与 AstrBot）；操作记录保存下发到教室电脑的每一条命令。</p>
    <form method="post" asp-page-handler="SaveOperationsSettings" class="stack system-config-form">
        <label class="check"><input asp-for="OperationsOptions.DeviceAlertsEnabled" /> 启用设备离线告警</label>
        <label>连续离线多少分钟后告警<input asp-for="OperationsOptions.DeviceAlertThresholdMinutes" type="number" min="5" max="120" /></label>
        <label class="check"><input asp-for="OperationsOptions.DeviceAlertSchoolHoursOnly" /> 只在班级当天在校时段告警（第一节课前 30 分钟至最后一节下课）</label>
        <label class="check"><input asp-for="OperationsOptions.DeviceAlertNotifyAdmins" /> 通知系统管理员</label>
        <label class="check"><input asp-for="OperationsOptions.DeviceAlertNotifyClassHeads" /> 通知该班班主任</label>
        <label>操作记录保留天数<input asp-for="OperationsOptions.AuditRetentionDays" type="number" min="7" max="3650" /></label>
        <label class="check"><input asp-for="OperationsOptions.ProfileDriftCheckEnabled" /> 每天检查教室电脑档案是否与服务端一致</label>
        <label>每日检查时间（服务端本地时间，选在教室电脑通常开机的时段）<input asp-for="OperationsOptions.ProfileDriftCheckTime" type="time" /></label>
        <button type="submit">保存集控运维设置</button>
    </form>
</section>

<section class="panel update-panel" id="update" data-tab="maintenance">
    <h2>系统更新@(Model.IsFnos ? "（飞牛 fnOS）" : "")</h2>
    @if (Model.IsPlatformManaged)
    {
        <p class="muted">当前服务端版本 @(Model.CurrentVersion)。</p>
        <p class="notice ok">@UpdateService.FnosManagedMessage</p>
    }
    else if (Model.IsDevelopment)
    {
        <p class="muted">当前服务端版本 @(Model.CurrentVersion)（开发构建）。</p>
        <p class="notice warn">@UpdateService.DevelopmentManagedMessage</p>
    }
    else
    {
        <p class="muted">当前服务端版本 @(Model.CurrentVersion)，更新从 GitHub Release 拉取。</p>
        @if (Model.UsesPersistentOverlay)
        {
            <p class="muted">更新会安装到应用数据目录，容器重建后仍然有效@(Model.IsFnos ? "；fnOS 应用中心显示的版本号不会随之变化" : "")。之后安装新的@(Model.IsFnos ? " FPK" : "镜像")会改用其中的版本；新版本首次启动失败时自动退回原版本。</p>
        }
        <form method="post" asp-page-handler="CheckUpdate" class="stack system-config-form">
            <label>更新渠道
                <select asp-for="UpdateOptions.Channel">
                    <option value="Stable">正式版</option>
                    <option value="Beta">Beta版（包含正式版）</option>
                </select>
            </label>
            <label class="check"><input asp-for="UpdateOptions.Force" /> 强制更新（同版本重新下载并覆盖安装）</label>
            <button type="submit">检查更新</button>
        </form>
        @if (!string.IsNullOrEmpty(Model.CheckMessage))
        {
            <p class="notice @(Model.UpdateSucceeded ? "ok" : "warn")">@Model.CheckMessage</p>
        }
        @if (Model.LatestRelease is not null)
        {
            var latestVersion = UpdateService.NormalizeVersion(Model.LatestRelease.Tag);
            var hasNewer = UpdateService.IsNewer(latestVersion, Model.CurrentVersion);
            var canInstall = UpdateService.CanInstall(latestVersion, Model.CurrentVersion, Model.UpdateOptions.Force);
            <p class="muted">所选渠道最新版本 @(latestVersion)@(Model.LatestRelease.Prerelease ? "（Beta）" : "")</p>
            @if (!string.IsNullOrEmpty(Model.LatestRelease.Body))
            {
                <details class="release-notes"><summary>查看更新说明</summary><div class="markdown-body">@Html.Raw(ReleaseNotesRenderer.ToHtml(Model.LatestRelease.Body))</div></details>
            }
            @if (canInstall && Model.ServerAsset is not null)
            {
                <form method="post" asp-page-handler="Update" class="stack system-config-form" onsubmit="this.querySelector('button').disabled=true;this.querySelector('button').textContent='处理中…'">
                    <input type="hidden" asp-for="UpdateOptions.Channel" />
                    <input type="hidden" asp-for="UpdateOptions.Force" />
                    <button type="submit">@(hasNewer ? $"下载并更新到 {latestVersion}" : $"重新下载并覆盖安装 {latestVersion}")</button>
                </form>
            }
            else if (hasNewer)
            {
                <p class="muted">当前平台暂无可用的更新包，请到 GitHub 手动下载。</p>
            }
        }
        <details class="release-notes mobile-desktop-only">
            <summary>手动上传更新包（调试）</summary>
            <p class="muted">上传当前平台（@Model.CurrentPlatform）的服务端发布包 zip，例如 GitHub Release 中的 RemoteCI.Server-版本-@(Model.CurrentPlatform).zip 或本地 dotnet publish 输出打包。不校验 SHA-256，允许同版本覆盖和降级；降级后若数据库结构不兼容可能无法启动。</p>
            <form method="post" asp-page-handler="UploadUpdate" enctype="multipart/form-data" class="stack system-config-form" onsubmit="if(!confirm('将用上传的更新包覆盖当前服务端并重启，确定继续？'))return false;this.querySelector('button').disabled=true;this.querySelector('button').textContent='上传并安装中…'">
                <label>更新包<input asp-for="UpdatePackage" type="file" accept=".zip" required /></label>
                <button type="submit" class="danger">上传并安装</button>
            </form>
        </details>
    }
</section>

<section class="panel" id="backup" data-tab="maintenance">
    <h2>自动备份</h2>
    <p class="muted">默认每天 02:00 执行，备份文件保存在数据库目录下的 backups 文件夹。</p>
    <form method="post" asp-page-handler="SaveBackupSettings" class="form-grid" data-backup-settings-form>
        <label class="check"><input asp-for="BackupOptions.Enabled" /> 启用自动备份</label>
        <label>备份周期<select asp-for="BackupOptions.Cadence" data-backup-cadence><option value="Hourly">每小时</option><option value="Daily">每天</option><option value="Weekly">每周</option></select></label>
        <label data-backup-time hidden="@(Model.BackupOptions.Cadence == BackupCadence.Hourly)">执行时间<input asp-for="BackupOptions.TimeOfDay" type="time" disabled="@(Model.BackupOptions.Cadence == BackupCadence.Hourly)" /></label>
        <label data-backup-weekday hidden="@(Model.BackupOptions.Cadence != BackupCadence.Weekly)">每周执行日<select asp-for="BackupOptions.DayOfWeek" disabled="@(Model.BackupOptions.Cadence != BackupCadence.Weekly)"><option value="Monday">星期一</option><option value="Tuesday">星期二</option><option value="Wednesday">星期三</option><option value="Thursday">星期四</option><option value="Friday">星期五</option><option value="Saturday">星期六</option><option value="Sunday">星期日</option></select></label>
        <label>最大备份数<input asp-for="BackupOptions.MaxBackups" type="number" min="1" max="100" /></label>
        <button type="submit">保存备份设置</button>
    </form>
    <form method="post" asp-page-handler="BackupNow" class="inline-form"><button type="submit" class="ghost">立即备份</button></form>
</section>
<section class="panel" id="backups" data-tab="maintenance">
    <h2>本地备份</h2>
    @if (Model.Backups.Count == 0) { <p class="muted">尚无本地备份。</p> }
    else { <div class="backup-list">@foreach (var backup in Model.Backups) { <article><div><strong>@backup.Name</strong><small>@backup.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") · @Math.Ceiling(backup.Size / 1024d) KB</small></div><div class="row-actions"><a class="button ghost" asp-page-handler="DownloadBackup" asp-route-name="@backup.Name">下载</a><form method="post" asp-page-handler="RestoreBackup" onsubmit="return confirm('恢复会替换当前配置并重启服务，确定继续？')"><input type="hidden" name="name" value="@backup.Name" /><button type="submit" class="ghost">恢复</button></form><form method="post" asp-page-handler="DeleteBackup" onsubmit="return confirm('确定删除此备份？')"><input type="hidden" name="name" value="@backup.Name" /><button type="submit" class="danger ghost">删除</button></form></div></article> }</div> }
</section>
<section class="panel two-column mobile-desktop-only" id="config-archive" data-tab="maintenance">
    <div><h2>导出加密配置</h2><p class="muted">包含课程、账号密码哈希、角色权限、插件长期凭据和可修改系统设置。</p>@if (Model.UnreadableTwoFactorUsers.Count > 0) { <div class="notice warning" role="alert">以下账号的二步验证密钥无法用当前密钥环解密（<code>keys/</code> 目录可能丢失或被替换）：@string.Join("、", Model.UnreadableTwoFactorUsers)。导出包会保留原密文，这些账号迁移后仍只能用恢复码登录，登录后请关闭并重新绑定二步验证。</div> }<form method="post" asp-page-handler="ExportConfig" class="stack"><label>导出密码<input asp-for="ExportOptions.Password" type="password" minlength="8" required /></label><label>确认密码<input asp-for="ExportOptions.ConfirmPassword" type="password" minlength="8" required /></label><button type="submit">导出配置包</button></form></div>
    <div><h2>导入加密配置</h2><p class="muted">导入前会自动备份当前配置，成功后清除设备会话、断开连接并重启服务。</p><form method="post" asp-page-handler="ImportConfig" enctype="multipart/form-data" class="stack" onsubmit="return confirm('导入将完整替换当前配置，确定继续？')"><label>配置包<input asp-for="ImportOptions.File" type="file" accept=".rcicfg" required /></label><label>配置包密码<input asp-for="ImportOptions.Password" type="password" minlength="8" required /></label><button type="submit" class="danger">导入并重启</button></form></div>
</section>
