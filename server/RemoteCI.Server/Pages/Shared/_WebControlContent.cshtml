@model ControlModel
@{
    ViewData["Title"] = "控制";
    var snapshot = Model.Snapshot;
    var mainMenuVisible = snapshot?.IsMainMenuVisible ?? true;
    var volumeAvailable = snapshot?.IsVolumeControlAvailable == true;
}
<div class="page-head">
    <div>
        <p class="eyebrow">ClassIsland 远程操作</p>
        <h1>控制</h1>
    </div>
    <span class="status @(Model.PluginOnline ? "online" : "offline")">@(Model.PluginOnline ? "插件在线" : "插件离线")</span>
</div>

@await Html.PartialAsync("_BatchResults", Model)
@if (MobileUi.IsMobile(Context) && !Model.HasClassroomOperations && !Model.CanControlMainMenu && !Model.CanControlVolume && !Model.CanUseExtensions)
{ <section class="panel mobile-empty"><i class="icon icon-tune"></i><h2>没有可用的控制项</h2><p>可用操作取决于账号权限和当前插件能力。</p></section> }

@* 复用批量控制页的动作卡片与参数弹窗；SingleControl 模式下目标固定为当前班级。 *@
@await Html.PartialAsync("_BatchControlActions", Model)

@* 班级控制页独有、且无需填写参数的操作：点击后直接执行或跳到下方编辑区。 *@
<section class="panel batch-section control-command-section" aria-labelledby="control-extra-actions-title">
    <div class="panel-heading"><div><h2 id="control-extra-actions-title">当前班级</h2></div></div>
    <div class="batch-action-grid">
        @if (Model.CanControlMainMenu)
        {
            <form method="post" asp-page-handler="MainMenu" class="batch-action-card-form">
                <input type="hidden" name="visible" value="@(!mainMenuVisible ? "true" : "false")" />
                <button type="submit" class="batch-action-card" disabled="@(!Model.PluginOnline)"><span class="batch-action-icon"><i class="icon @(mainMenuVisible ? "icon-visibility-off" : "icon-visibility")" aria-hidden="true"></i></span><span class="batch-action-copy"><strong>@(mainMenuVisible ? "隐藏主界面" : "显示主界面")</strong><small>切换设备上的 ClassIsland 主界面。</small></span></button>
            </form>
        }
        @if (Model.CanUploadMainWindowLayout || Model.CanReadMainWindowLayout)
        {
            <button type="button" class="batch-action-card" data-user-edit-open="main-window-layout-dialog" aria-controls="main-window-layout-dialog"><span class="batch-action-icon"><i class="icon icon-upload-file" aria-hidden="true"></i></span><span class="batch-action-copy"><strong>主界面文件</strong><small>上传或获取 ClassIsland 主界面文件。</small></span></button>
        }
        @if (Model.CanControlVolume)
        {
            <button type="button" class="batch-action-card" data-user-edit-open="volume-dialog" aria-controls="volume-dialog"><span class="batch-action-icon"><i class="icon icon-volume-up" aria-hidden="true"></i></span><span class="batch-action-copy"><strong>音量调节</strong><small>调节设备音量或静音。</small></span></button>
        }
        @if (Model.CanCaptureScreen)
        {
            <button type="button" class="batch-action-card" data-user-edit-open="screenshot-dialog" aria-controls="screenshot-dialog"><span class="batch-action-icon"><i class="icon icon-desktop-windows" aria-hidden="true"></i></span><span class="batch-action-copy"><strong>屏幕截图</strong><small>查看教室电脑当前屏幕。</small></span></button>
        }
        @if (Model.CanManageClassInfo)
        {
            <button type="button" class="batch-action-card" data-user-edit-open="class-info-dialog" aria-controls="class-info-dialog"><span class="batch-action-icon"><i class="icon icon-library-books" aria-hidden="true"></i></span><span class="batch-action-copy"><strong>班级设置</strong><small>@(Model.ClassSelfService.CanRename && Model.ClassSelfService.CanChangeAvatar ? "修改班级名称与头像。" : Model.ClassSelfService.CanRename ? "修改班级名称。" : "修改班级头像。")</small></span></button>
        }
    </div>
</section>

@if (Model.CanManageClassInfo)
{
    <dialog id="class-info-dialog" class="user-edit-dialog" data-user-edit-dialog aria-labelledby="class-info-dialog-title">
        <div class="user-edit-dialog-shell">
            <header class="user-edit-dialog-header"><div><p class="eyebrow">当前班级</p><h2 id="class-info-dialog-title">班级设置</h2><p class="muted">头像会显示在选班页、访客页与客户端班级列表。</p></div><button type="button" class="ghost dialog-close-button" data-user-edit-close aria-label="关闭班级设置"><i class="icon icon-close" aria-hidden="true"></i></button></header>
            <div class="class-info-body user-edit-form">
                @await Html.PartialAsync("_ClassAvatar", new ClassAvatarModel(Model.CurrentClassId, Model.HasAvatar, Alt: "班头像"))
                @* 班名与头像分别受班级自治策略控制；系统管理员两项都可用。 *@
                @if (Model.ClassSelfService.CanRename)
                {
                    <form method="post" asp-page-handler="ClassInfo" class="stack">
                        <label>班名<input asp-for="ClassNameInput" maxlength="40" placeholder="@Model.CurrentClass?.Name" /></label>
                        <button type="submit">保存班名</button>
                    </form>
                }
                @if (Model.ClassSelfService.CanChangeAvatar)
                {
                    <form method="post" asp-page-handler="Avatar" enctype="multipart/form-data" class="stack">
                        <label>班头像（PNG/JPEG/WebP，≤256KB）<input type="file" asp-for="AvatarFile" accept="image/png,image/jpeg,image/webp" /></label>
                        <button type="submit">上传头像</button>
                    </form>
                    @if (Model.HasAvatar)
                    {
                        <form method="post" asp-page-handler="RemoveAvatar">
                            <button type="submit" class="ghost">清除头像</button>
                        </form>
                    }
                }
            </div>
        </div>
    </dialog>
}

@if (Model.CanCaptureScreen)
{
    <dialog id="screenshot-dialog" class="user-edit-dialog screenshot-dialog" data-user-edit-dialog data-screenshot-dialog
            data-capture-url="@Url.Page("/Control", "Screenshot")" data-list-url="@Url.Page("/Control", "Screenshots")" aria-labelledby="screenshot-dialog-title">
        <div class="user-edit-dialog-shell">
            <header class="user-edit-dialog-header"><div><p class="eyebrow">当前班级</p><h2 id="screenshot-dialog-title">屏幕截图</h2><p class="muted">截取教室电脑全部显示器的当前画面，保留 24 小时；每次截图都会写入操作记录。</p></div><button type="button" class="ghost dialog-close-button" data-user-edit-close aria-label="关闭屏幕截图"><i class="icon icon-close" aria-hidden="true"></i></button></header>
            <div class="user-edit-form screenshot-body">
                <form method="post" class="screenshot-actions" data-screenshot-form>
                    @Html.AntiForgeryToken()
                    <button type="submit" data-screenshot-capture disabled="@(!Model.PluginOnline)">立即截图</button>
                    <span class="control-note" data-screenshot-status aria-live="polite">@(Model.PluginOnline ? "" : "插件离线，无法截图")</span>
                </form>
                <figure class="screenshot-preview" data-screenshot-preview hidden>
                    <a data-screenshot-open target="_blank" rel="noopener"><img data-screenshot-image alt="教室电脑屏幕截图" /></a>
                    <figcaption><span data-screenshot-caption></span> <a data-screenshot-download>下载</a></figcaption>
                </figure>
                <div class="screenshot-history" data-screenshot-history hidden>
                    <h3>最近截图</h3>
                    <ul data-screenshot-list></ul>
                </div>
            </div>
        </div>
    </dialog>
    <script src="~/screenshot.js" asp-append-version="true" defer></script>
}

@if (Model.CanUploadMainWindowLayout || Model.CanReadMainWindowLayout)
{
    <dialog id="main-window-layout-dialog" class="user-edit-dialog" data-user-edit-dialog aria-labelledby="main-window-layout-dialog-title">
        <div class="user-edit-dialog-shell">
            <header class="user-edit-dialog-header"><div><p class="eyebrow">当前班级</p><h2 id="main-window-layout-dialog-title">主界面文件</h2><p class="muted">即 ClassIsland 设置中“主界面”的组件配置文件（Config/ComponentLayouts/*.json）。设备处于集控模式时只能获取。</p></div><button type="button" class="ghost dialog-close-button" data-user-edit-close aria-label="关闭主界面文件"><i class="icon icon-close" aria-hidden="true"></i></button></header>
            <div class="user-edit-form stack">
                @if (Model.CanUploadMainWindowLayout)
                {
                    <form method="post" asp-page-handler="MainWindowLayout" enctype="multipart/form-data" class="stack">
                        <label>主界面文件（JSON，≤2MB）<input type="file" name="LayoutFile" accept=".json,application/json" required /></label>
                        <fieldset class="stack">
                            <legend>写入方式</legend>
                            <label class="check"><input type="radio" name="LayoutMode" value="@((int)MainWindowLayoutApplyMode.OverwriteCurrent)" checked /> 覆盖当前主界面文件（立即生效）</label>
                            <label class="check"><input type="radio" name="LayoutMode" value="@((int)MainWindowLayoutApplyMode.CreateNew)" /> 新建主界面文件</label>
                        </fieldset>
                        <label>新文件名（仅新建时使用）<input type="text" name="LayoutName" maxlength="@MainWindowLayoutRules.MaxNameLength" placeholder="例如：期末考试" /></label>
                        <label class="check"><input type="checkbox" name="LayoutActivate" value="true" checked /> 新建后立即使用该主界面文件</label>
                        <button type="submit" disabled="@(!Model.PluginOnline)">上传</button>
                    </form>
                }
                @if (Model.CanReadMainWindowLayout)
                {
                    <form method="post" asp-page-handler="DownloadMainWindowLayout">
                        <button type="submit" class="ghost" disabled="@(!Model.PluginOnline)"><i class="icon icon-cloud-download" aria-hidden="true"></i> 获取当前主界面文件</button>
                    </form>
                }
                @if (!Model.PluginOnline)
                {
                    <p class="control-note">插件离线，无法上传或获取主界面文件。</p>
                }
            </div>
        </div>
    </dialog>
}

@if (Model.CanControlVolume)
{
    <dialog id="volume-dialog" class="user-edit-dialog" data-user-edit-dialog aria-labelledby="volume-dialog-title">
        <div class="user-edit-dialog-shell">
            <header class="user-edit-dialog-header"><div><p class="eyebrow"><i class="icon @(snapshot?.IsMuted == true ? "icon-volume-off" : "icon-volume-up")" aria-hidden="true" data-volume-icon></i> 当前班级</p><h2 id="volume-dialog-title">音量调节</h2><p class="muted" data-volume-summary>当前音量 @(snapshot?.VolumePercent ?? 0)% · @(snapshot?.IsMuted == true ? "已静音" : "未静音")</p></div><button type="button" class="ghost dialog-close-button" data-user-edit-close aria-label="关闭音量调节"><i class="icon icon-close" aria-hidden="true"></i></button></header>
            <div class="control-actions user-edit-form">
                <form method="post" asp-page-handler="Volume" class="volume-form" data-volume-form>
                    <label>Windows 主音量
                        <span class="range-field">
                            <input asp-for="VolumeLevel" type="range" min="0" max="100"
                                   data-volume-slider data-muted="@(snapshot?.IsMuted == true ? "true" : "false")"
                                   disabled="@(!Model.PluginOnline || !volumeAvailable)" />
                            <output data-volume-output>@Model.VolumeLevel%</output>
                        </span>
                    </label>
                    <span class="control-note" data-volume-feedback aria-live="polite">拖动后自动应用</span>
                </form>
                <form method="post" asp-page-handler="Mute" data-mute-form>
                    <input type="hidden" name="muted" value="@(snapshot?.IsMuted != true ? "true" : "false")" />
                    <button class="ghost" type="submit" data-mute-button disabled="@(!Model.PluginOnline || !volumeAvailable)">@(snapshot?.IsMuted == true ? "取消静音" : "静音")</button>
                </form>
            </div>
            @if (!volumeAvailable)
            {
                <p class="control-note">插件尚未报告可用的 Windows 默认播放设备。</p>
            }
        </div>
    </dialog>
}

<div class="control-grid">
    @if (Model.CanUseExtensions)
    {
        <section class="panel control-card control-card-full" id="extensions">
            <div class="control-card-head">
                <span class="feature-icon"><i class="icon icon-extension" aria-hidden="true"></i></span>
                <div><h2>扩展功能</h2><p class="muted">由其他 ClassIsland 插件注册的功能，按插件分组显示。</p></div>
            </div>
            @if (!Model.ExtensionGroups.Any(Model.ShowExtensionGroup))
            {
                <p class="muted">当前没有向此账号开放的扩展功能。</p>
            }
            @{ var extensionIndex = 0; }
            @foreach (var group in Model.ExtensionGroups.Where(Model.ShowExtensionGroup))
            {
            <div class="extension-group" data-extension-group="@group.Id">
                <div class="extension-group-head">
                    <div class="extension-identity">
                        <strong>@group.DisplayName</strong>
                        @if (!string.IsNullOrWhiteSpace(group.Description)) { <small>@group.Description</small> }
                    </div>
                    @if (Model.CanEditExtensionSettings(group))
                    {
                        <a class="button ghost" asp-page="/ClassExtensions" asp-route-groupId="@group.Id"><i class="icon icon-tune" aria-hidden="true"></i> 插件设置</a>
                    }
                </div>
            <div class="extension-list">
                @if (group.Extensions.Count == 0)
                {
                    <p class="muted">该插件没有可执行的扩展功能，可在插件设置中统一调整。</p>
                }
                @foreach (var extension in group.Extensions)
                {
                    var item = Model.ExtensionItem(extension);
                    var runDialogId = $"extension-run-{extensionIndex}";
                    var editDialogId = $"extension-edit-{extensionIndex}";
                    <article class="extension-control-row">
                        <div class="extension-identity"><strong>@extension.DisplayName</strong>@if (!string.IsNullOrWhiteSpace(extension.Description)) { <small>@extension.Description</small> }<small>ID：@extension.Id</small></div>
                        <div class="extension-row-actions">
                            @if ((extension.Parameters?.Count ?? 0) == 0)
                            {
                                <form method="post" asp-page-handler="Extension">
                                    <input type="hidden" name="extensionId" value="@extension.Id" />
                                    <button type="submit" disabled="@(!Model.PluginOnline || !item.CanInvoke)">执行</button>
                                </form>
                            }
                            else
                            {
                                <button type="button" disabled="@(!Model.PluginOnline || !item.CanInvoke)" data-user-edit-open="@runDialogId" aria-controls="@runDialogId">执行</button>
                            }
                            <button class="ghost" type="button" data-user-edit-open="@editDialogId" aria-controls="@editDialogId">编辑</button>
                        </div>
                    </article>

                    @if ((extension.Parameters?.Count ?? 0) > 0)
                    {
                        <dialog id="@runDialogId" class="user-edit-dialog" data-user-edit-dialog aria-labelledby="@($"{runDialogId}-title")">
                            <div class="user-edit-dialog-shell">
                                <header class="user-edit-dialog-header"><div><p class="eyebrow">执行扩展</p><h2 id="@($"{runDialogId}-title")">@extension.DisplayName</h2><small>ID：@extension.Id</small></div><button type="button" class="ghost dialog-close-button" data-user-edit-close aria-label="关闭执行窗口"><i class="icon icon-close" aria-hidden="true"></i></button></header>
                                <form method="post" asp-page-handler="Extension" class="stack extension-dialog-form">
                                    <input type="hidden" name="extensionId" value="@extension.Id" />
                                    @await Html.PartialAsync("_ExtensionFields", new ExtensionFieldsModel(extension.Parameters!, "ExtensionInputs", runDialogId))
                                    <div class="dialog-actions"><button type="button" class="ghost" data-user-edit-close>取消</button><button type="submit">执行</button></div>
                                </form>
                            </div>
                        </dialog>
                    }

                    <dialog id="@editDialogId" class="user-edit-dialog" data-user-edit-dialog aria-labelledby="@($"{editDialogId}-title")">
                        <div class="user-edit-dialog-shell">
                            <header class="user-edit-dialog-header"><div><p class="eyebrow">扩展设置</p><h2 id="@($"{editDialogId}-title")">@extension.DisplayName</h2><small>ID：@extension.Id</small></div><button type="button" class="ghost dialog-close-button" data-user-edit-close aria-label="关闭编辑窗口"><i class="icon icon-close" aria-hidden="true"></i></button></header>
                            @if (Model.IsAdmin)
                            {
                                <form method="post" asp-page-handler="ExtensionPolicy" class="stack extension-dialog-form">
                                    <input type="hidden" name="extensionId" value="@extension.Id" />
                                    <label class="check"><input type="checkbox" name="enabled" value="true" checked="@item.Enabled" /> 启用扩展功能</label>
                                    <label class="check"><input type="checkbox" name="allowNonAdmin" value="true" checked="@item.AllowNonAdmin" /> 对非管理员用户开放</label>
                                    <label class="check"><input type="checkbox" name="showOnWatch" value="true" checked="@item.ShowOnWatch" /> 在我自己的手表上展示</label>
                                    <p class="muted">关闭后所有账号都不能执行；开放后，普通账号还需拥有“扩展功能”权限。</p>
                                    <div class="dialog-actions"><button type="button" class="ghost" data-user-edit-close>取消</button><button type="submit">保存设置</button></div>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="ExtensionPreference" class="stack extension-dialog-form">
                                    <input type="hidden" name="extensionId" value="@extension.Id" />
                                    <label class="check"><input type="checkbox" name="showOnWatch" value="true" checked="@item.ShowOnWatch" /> 在我自己的手表上展示</label>
                                    <p class="muted">只影响你自己的手表。</p>
                                    <div class="dialog-actions"><button type="button" class="ghost" data-user-edit-close>取消</button><button type="submit">保存设置</button></div>
                                </form>
                            }
                        </div>
                    </dialog>
                    extensionIndex++;
                }
            </div>
            </div>
            }
        </section>
    }
</div>
