@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<AppUser> UserManager
@inject RemoteCI.Server.Services.LoginPageSettings loginPageSettings
@inject RemoteCI.Server.Services.ClassAccessService classAccess
@inject RemoteCI.Server.Services.ExtensionGroupService extensionGroups
@inject RemoteCI.Server.Services.ScheduleSwapService swapRequests
@inject AppDbContext Db
@{
    var current = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var roleDefaults = current is null
        ? UserPermissions.None
        : await Db.AccountRoles.AsNoTracking()
            .Where(role => role.Id == current.RoleDefinitionId)
            .Select(role => role.DefaultPermissions)
            .SingleOrDefaultAsync();
    var permissions = current is null
        ? UserPermissions.None
        : RolePermissions.Effective(current.Role, current.GrantedPermissions, roleDefaults);
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var hasPersonalSchedule = current is not null;
    var canRequestSwap = current is not null && permissions.HasFlag(UserPermissions.RequestScheduleSwap);
    // 铃铛未读数与换课页待处理数在服务端渲染首屏，之后由 notifications.js 轮询刷新。
    var unreadNotifications = current is null ? 0 : await Db.UserNotifications.CountAsync(x => x.UserId == current.Id && x.ReadAt == null);
    var pendingSwaps = current is null || !canRequestSwap ? 0 : await swapRequests.CountPendingForAsync(current.Id);
    string NavClass(string page) => currentPage == page ? "nav-link active" : "nav-link";
    string? CurrentPage(string page) => currentPage == page ? "page" : null;
    var userInitial = string.IsNullOrWhiteSpace(current?.DisplayName) ? "R" : current.DisplayName.Trim()[0].ToString().ToUpperInvariant();
    var controlMenuActive = currentPage is "/Control" or "/Notifications";
    // “系统设置”是一组带 tab 的页面：常规与维护、登录与访问、插件与课表同步共用一个侧边栏入口。
    var systemSettingsActive = currentPage is "/SystemConfig" or "/LoginSettings" or "/PluginAccess";
    var showControlMenu = permissions.HasFlag(UserPermissions.SendNotifications) ||
        permissions.HasFlag(UserPermissions.SendVoiceMessages) ||
        permissions.HasFlag(UserPermissions.PowerControl) ||
        permissions.HasFlag(UserPermissions.MainMenuControl) ||
        permissions.HasFlag(UserPermissions.RunExtensions);
    // 班级切换器：可访问班级与 Cookie 选中的当前班级；没有可访问班级时不渲染。
    IReadOnlyList<RemoteCI.Shared.Models.ClassSummary> accessibleClasses = Array.Empty<RemoteCI.Shared.Models.ClassSummary>();
    Guid currentClassId = Guid.Empty;
    if (current is not null)
    {
        // 与页面/API 共用班级访问服务，教师按课表姓名绑定的任教班级也必须进入上下文。
        accessibleClasses = await classAccess.GetAccessibleClassesAsync(
            current.Id, current.Role, current.GrantedPermissions, Context.RequestAborted);
        currentClassId = Guid.TryParse(Context.Request.Cookies[RemoteCI.Server.Pages.WebPageModel.CurrentClassCookie], out var cookieClass)
            && accessibleClasses.Any(x => x.Id == cookieClass)
            ? cookieClass
            : accessibleClasses.FirstOrDefault()?.Id ?? Guid.Empty;
    }
    var currentClassName = accessibleClasses.FirstOrDefault(x => x.Id == currentClassId)?.Name ?? "暂无班级";
    // 本班档案属于班级自治：仅管理员或本班班主任，并且具有本班课表管理权限。
    var showClassProfiles = current is not null && accessibleClasses.Any(x => x.Id == currentClassId)
        && await classAccess.IsClassAdminAsync(current.Id, current.Role, currentClassId, Context.RequestAborted)
        && (accessibleClasses.First(x => x.Id == currentClassId).Permissions ?? UserPermissions.None).HasFlag(UserPermissions.ManageSchedule);
    // 班级区的“扩展插件”入口只管理当前班级：系统管理员始终可见；班主任需系统管理员至少开放一个插件且本班有扩展功能权限。
    // 跨班级、按设备统一下发在“设备与控制”分组的“插件批量下发”中进行。
    var showClassExtensionSettings = current is not null
        && accessibleClasses.Any(x => x.Id == currentClassId)
        && (current.Role == UserRole.Admin || (await extensionGroups.ListClassAdminEditableAsync(
            current.Id, current.Role, current.GrantedPermissions, currentClassId, Context.RequestAborted))?.Count > 0);
    // 操作记录与课时统计：所有角色都在“记录与统计”分组；系统管理员看全部，班主任看自己担任班主任的班级。
    var showClassAuditLog = current is not null && current.Role != UserRole.Admin
        && accessibleClasses.Any(x => x.Id == currentClassId)
        && await classAccess.IsClassAdminAsync(current.Id, current.Role, currentClassId, Context.RequestAborted);
    // 电子班牌：系统管理员或本班班主任为当前班级生成班牌链接。
    var showClassBoards = current is not null && accessibleClasses.Any(x => x.Id == currentClassId)
        && await classAccess.IsClassAdminAsync(current.Id, current.Role, currentClassId, Context.RequestAborted);
    // 侧边栏左上角展示当前班级：已上传头像显示头像，未上传显示班级图标；还没有任何可访问班级时显示 RemoteCI logo。
    var hasCurrentClass = current is not null && accessibleClasses.Any(x => x.Id == currentClassId);
    var currentClassHasAvatar = hasCurrentClass
        && accessibleClasses.First(x => x.Id == currentClassId).HasAvatar == true;
    // 登录页外观由系统管理员配置：未登录页面（登录/设置密码等）按此渲染主题与背景，
    // 访客页与已登录页面继续沿用浏览器本地主题，互不影响。
    var loginAppearance = current is null && currentPage != "/Visitor"
        ? await loginPageSettings.GetAppearanceAsync()
        : null;
    var forcedLoginTheme = loginAppearance?.Theme switch
    {
        RemoteCI.Server.Data.LoginTheme.Light => "light",
        RemoteCI.Server.Data.LoginTheme.Dark => "dark",
        _ => string.Empty,
    };
    // 登录卡片位置交给 body 的 data-login-card，由样式贴近左侧或右侧摆放；未登录页面之外的布局不受影响。
    var loginCardPosition = loginAppearance?.CardPosition switch
    {
        RemoteCI.Server.Data.LoginCardPosition.Left => "left",
        RemoteCI.Server.Data.LoginCardPosition.Right => "right",
        _ => "center",
    };
    var loginStyleParts = new List<string>();
    if (loginAppearance?.HasBackground == true)
    {
        loginStyleParts.Add($"--login-bg-image:url('{Url.Content("~/api/settings/login-background")}?v={loginAppearance.BackgroundUpdatedAt?.Ticks ?? 0}')");
        loginStyleParts.Add($"--login-bg-opacity:{Math.Clamp(loginAppearance.Opacity, 0, 100) / 100d:0.##}");
    }
    var hasLoginBackground = loginAppearance?.HasBackground == true;
    var loginBackgroundStyle = loginStyleParts.Count == 0 ? null : string.Join(';', loginStyleParts);
}
<!doctype html>
<html lang="zh-CN" data-login-theme-forced="@forcedLoginTheme" data-ui-preference="@Context.Request.Cookies[MobileUi.Cookie]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · RemoteCI</title>
    <script>if(document.documentElement.dataset.uiPreference!=='desktop' && matchMedia('(max-width:820px) and (pointer:coarse)').matches && !new URL(location.href).searchParams.has('handler')) {const url=new URL(location.href);url.searchParams.set('view','mobile');location.replace(url);}</script>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <link rel="icon" href="~/favicon.ico" sizes="16x16 32x32 48x48" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/material-symbols/material-symbols.css" asp-append-version="true" />
    @* 主题在样式表之前确定，避免登录页出现明暗闪烁；管理员强制主题优先于本地偏好。 *@
    <script>try { document.documentElement.dataset.theme = "@forcedLoginTheme" || (localStorage.getItem("remoteci-theme") === "light" ? "light" : "dark"); } catch { document.documentElement.dataset.theme = "dark"; }</script>
    <link rel="expect" href="#page-state-ready" blocking="render" />
    <link rel="stylesheet" href="~/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/premium.css" asp-append-version="true" />
</head>
<body class="@(currentPage == "/Visitor" ? "visitor-layout" : current is null ? "auth-layout" : "app-layout")@(hasLoginBackground ? " has-login-background" : "")" style="@loginBackgroundStyle" data-login-card="@(current is null ? loginCardPosition : null)">
    @if (currentPage == "/Visitor")
    {
        <main class="shell visitor-shell">
            @if (TempData["Message"] is string visitorMessage) { <div class="flash">@visitorMessage</div> }
            @if (TempData["Error"] is string visitorError) { <div class="flash error">@visitorError</div> }
            @RenderBody()
        </main>
    }
    else if (current is not null)
    {
        <script>try { if (localStorage.getItem("remoteci-sidebar-collapsed") === "1" && !matchMedia("(max-width: 820px)").matches) document.body.classList.add("sidebar-collapsed"); } catch { }</script>
        <aside class="sidebar" aria-label="主导航" data-sidebar>
            <div class="brand">
                <a class="brand-link" href="@(permissions.HasFlag(UserPermissions.AccessWebUi) ? Url.Page("/Index") : Url.Page("/Account"))">
                    @* 左上角展示当前班级：有头像显示头像，没有头像显示班级图标；没有班级时显示 RemoteCI logo。
                       头像走 .brand-badge-avatar（铺满圆形、保留 alpha），不受 .brand-logo 的灰度提亮滤镜影响。 *@
                    @if (hasCurrentClass)
                    {
                        <span class="brand-badge brand-badge-avatar" title="@currentClassName">@await Html.PartialAsync("_ClassAvatar", new RemoteCI.Server.Pages.ClassAvatarModel(currentClassId, currentClassHasAvatar, "brand-avatar", currentClassName))</span>
                    }
                    else
                    {
                        <span class="brand-badge"><img class="brand-logo" src="~/logo-mark.svg" alt="" asp-append-version="true" /></span>
                    }
                    <span class="brand-copy"><strong>RemoteCI</strong><small>课堂控制中心</small></span>
                </a>
                <button class="sidebar-collapse-button" type="button" data-sidebar-toggle aria-label="展开或收起侧边栏" title="展开或收起侧边栏"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18m7-6l-3-3l3-3"/></g></svg></button>
            </div>
            <nav class="side-nav">
                <div class="nav-group" data-nav-group="daily">
                <button class="nav-section-label" type="button" data-nav-group-toggle aria-expanded="true">日常</button>
                @if (permissions.HasFlag(UserPermissions.AccessWebUi))
                {
                    <a class="@NavClass("/Index")" aria-current="@CurrentPage("/Index")" asp-page="/Index" data-search-label="概览 仪表盘 课堂状态 连接诊断"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></g></svg><span>概览</span></a>
                }
                    <a class="@NavClass("/Schedule")" aria-current="@CurrentPage("/Schedule")" asp-page="/Schedule" data-search-label="课表 课程安排 从插件拉取课表"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M8 2v3m8-3v3"/><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M8 13h.01M12 13h.01M16 13h.01M8 17h.01M12 17h.01M16 17h.01"/></g></svg><span>课表</span></a>
                @if (showControlMenu)
                {
                    <a class="@(controlMenuActive ? "nav-link active" : "nav-link")" aria-current="@(controlMenuActive ? "page" : null)" asp-page="/Control" data-search-label="控制 发送通知 清除通知 主界面 音量 电源 扩展"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 5H3m9 14H3M14 3v4m2 10v4m5-9h-9m9 7h-5m5-14h-7m-6 5v4m0-2H3"/></svg><span>控制</span></a>
                }
                </div>
                @if (hasPersonalSchedule || canRequestSwap)
                {
                    <div class="nav-group" data-nav-group="mine">
                    <button class="nav-section-label" type="button" data-nav-group-toggle aria-expanded="true">我的</button>
                    @if (hasPersonalSchedule)
                    {
                        <a class="@NavClass("/MySchedule")" aria-current="@CurrentPage("/MySchedule")" asp-page="/MySchedule" data-search-label="我的日程 教师课表 任教班级"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M8 2v3m8-3v3M3 9h18M8 13h.01M12 13h.01M16 13h.01M8 17h.01M12 17h.01M16 17h.01"/></g></svg><span>我的日程</span></a>
                    }
                    @if (canRequestSwap)
                    {
                        <a class="@NavClass("/SwapRequests")" aria-current="@CurrentPage("/SwapRequests")" asp-page="/SwapRequests" data-search-label="换课申请 调课 强制换课 审批换课"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m16 3l4 4l-4 4"/><path d="M20 7H4m4 14l-4-4l4-4"/><path d="M4 17h16"/></g></svg><span>换课</span><span class="nav-badge" data-swap-badge hidden="@(pendingSwaps == 0)">@pendingSwaps</span></a>
                    }
                    </div>
                }
                @if (showClassProfiles || showClassExtensionSettings || showClassBoards)
                {
                    <div class="nav-group" data-nav-group="class">
                    <button class="nav-section-label" type="button" data-nav-group-toggle aria-expanded="true">本班 · @currentClassName</button>
                    @if (showClassProfiles)
                    {
                        <a class="@NavClass("/ClassProfiles")" aria-current="@CurrentPage("/ClassProfiles")" asp-page="/ClassProfiles" data-search-label="本班档案 班级档案 档案 时间表 课程表 科目 上传档案"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M3 7V5a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M3 8h18"/></g></svg><span>本班档案</span></a>
                    }
                    @if (showClassExtensionSettings)
                    {
                        <a class="@NavClass("/ClassExtensions")" aria-current="@CurrentPage("/ClassExtensions")" asp-page="/ClassExtensions" data-search-label="本班插件 扩展插件 插件设置 扩展设置"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.39 4.39a1 1 0 0 0 1.68-.474a2.5 2.5 0 1 1 3.014 3.015a1 1 0 0 0-.474 1.68l1.683 1.682a2.414 2.414 0 0 1 0 3.414L19.61 15.39a1 1 0 0 1-1.68-.474a2.5 2.5 0 1 0-3.014 3.015a1 1 0 0 1 .474 1.68l-1.683 1.682a2.414 2.414 0 0 1-3.414 0L8.61 19.61a1 1 0 0 0-1.68.474a2.5 2.5 0 1 1-3.014-3.015a1 1 0 0 0 .474-1.68l-1.683-1.682a2.414 2.414 0 0 1 0-3.414L4.39 8.61a1 1 0 0 1 1.68.474a2.5 2.5 0 1 0 3.014-3.015a1 1 0 0 1-.474-1.68l1.683-1.682a2.414 2.414 0 0 1 3.414 0z"/></svg><span>本班插件</span></a>
                    }
                    @if (showClassBoards)
                    {
                        <a class="@NavClass("/ClassBoards")" aria-current="@CurrentPage("/ClassBoards")" asp-page="/ClassBoards" data-search-label="电子班牌 班牌 走廊大屏 门口屏"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><rect width="18" height="12" x="3" y="4" rx="2"/><path d="M7 20h10M12 16v4M7 9h4m-4 3h7"/></g></svg><span>电子班牌</span></a>
                    }
                    </div>
                }
                @if (current.Role == UserRole.Admin || showClassAuditLog)
                {
                    <div class="nav-group" data-nav-group="records">
                    <button class="nav-section-label" type="button" data-nav-group-toggle aria-expanded="true">记录与统计</button>
                        <a class="@NavClass("/AuditLog")" aria-current="@CurrentPage("/AuditLog")" asp-page="/AuditLog" data-search-label="操作记录 审计 日志 谁关机 命令记录"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9a9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5m4-1v5l4 2"/></g></svg><span>操作记录</span></a>
                        <a class="@NavClass("/LessonStats")" aria-current="@CurrentPage("/LessonStats")" asp-page="/LessonStats" data-search-label="课时统计 代课 课时 工作量"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M18 17V9m-5 8V5M8 17v-3"/></g></svg><span>课时统计</span></a>
                    </div>
                }
                @if (current.Role == UserRole.Admin)
                {
                    <div class="nav-group" data-nav-group="academic">
                    <button class="nav-section-label" type="button" data-nav-group-toggle aria-expanded="true">教务</button>
                        <a class="@NavClass("/Profiles")" aria-current="@CurrentPage("/Profiles")" asp-page="/Profiles" data-search-label="档案库 档案管理 批量时间表 批量课程表 上传解析"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 9v12M13 13h4m-4 4h4"/></g></svg><span>档案库</span></a>
                        <a class="@NavClass("/Holidays")" aria-current="@CurrentPage("/Holidays")" asp-page="/Holidays" data-search-label="学期 开学 单双周 教学周 调休 节假日 放假 补课 国庆 春节"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M9 16l2 2l4-4"/></g></svg><span>学期与调休</span></a>
                    </div>
                }
                @if (current.Role == UserRole.Admin)
                {
                    <div class="nav-group" data-nav-group="devices">
                    <button class="nav-section-label" type="button" data-nav-group-toggle aria-expanded="true">设备与控制</button>
                        <a class="@NavClass("/Devices")" aria-current="@CurrentPage("/Devices")" asp-page="/Devices" data-search-label="设备状态 在线 离线 告警 版本 大屏"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8m-4-4v4"/></g></svg><span>设备状态</span></a>
                        <a class="@NavClass("/BatchControl")" aria-current="@CurrentPage("/BatchControl")" asp-page="/BatchControl" data-search-label="批量控制 广播 通知 开关机 电源 语音"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M4.9 16.1C1 12.2 1 5.8 4.9 1.9m2.9 2.8a6.14 6.14 0 0 0-.8 7.5"/><circle cx="12" cy="9" r="2"/><path d="M16.2 4.8c2 2 2.26 5.11.8 7.47M19.1 1.9a9.96 9.96 0 0 1 0 14.1m-9.6 2h5M8 22l4-11l4 11"/></g></svg><span>批量控制</span></a>
                        <a class="@(currentPage is "/Automation" or "/AutomationEdit" ? "nav-link active" : "nav-link")" aria-current="@(currentPage is "/Automation" or "/AutomationEdit" ? "page" : null)" asp-page="/Automation" data-search-label="自动化 定时 关机 放学 规则 计划任务"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M10 2h4m-2 12l3-3"/><circle cx="12" cy="14" r="8"/></g></svg><span>自动化</span></a>
                        <a class="@NavClass("/AppGuard")" aria-current="@CurrentPage("/AppGuard")" asp-page="/AppGuard" data-search-label="应用守护 退出自启 崩溃重启 禁止删除 防删除 备份 恢复 守护进程"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12l2 2l4-4"/></g></svg><span>应用守护</span></a>
                        <a class="@NavClass("/ExtensionSettings")" aria-current="@CurrentPage("/ExtensionSettings")" asp-page="/ExtensionSettings" data-search-label="插件批量下发 插件批量设置 扩展插件 插件设置 批量下发 按设备"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.39 4.39a1 1 0 0 0 1.68-.474a2.5 2.5 0 1 1 3.014 3.015a1 1 0 0 0-.474 1.68l1.683 1.682a2.414 2.414 0 0 1 0 3.414L19.61 15.39a1 1 0 0 1-1.68-.474a2.5 2.5 0 1 0-3.014 3.015a1 1 0 0 1 .474 1.68l-1.683 1.682a2.414 2.414 0 0 1-3.414 0L8.61 19.61a1 1 0 0 0-1.68.474a2.5 2.5 0 1 1-3.014-3.015a1 1 0 0 0 .474-1.68l-1.683-1.682a2.414 2.414 0 0 1 0-3.414L4.39 8.61a1 1 0 0 1 1.68.474a2.5 2.5 0 1 0 3.014-3.015a1 1 0 0 1-.474-1.68l1.683-1.682a2.414 2.414 0 0 1 3.414 0z"/></svg><span>插件批量下发</span></a>
                    </div>
                }
                @if (current.Role == UserRole.Admin || permissions.HasFlag(UserPermissions.ManageUsers))
                {
                    <div class="nav-group" data-nav-group="org">
                    <button class="nav-section-label" type="button" data-nav-group-toggle aria-expanded="true">组织与权限</button>
                    @if (current.Role == UserRole.Admin)
                    {
                        <a class="@NavClass("/Classes")" aria-current="@CurrentPage("/Classes")" asp-page="/Classes" data-search-label="班级管理 班级 分组 成员 访客 连接码 设备分配"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m6.08 9.5l-3.5 1.6a1 1 0 0 0 0 1.81l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9a1 1 0 0 0 0-1.83l-3.5-1.59"/><path d="m6.08 14.5l-3.5 1.6a1 1 0 0 0 0 1.81l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9a1 1 0 0 0 0-1.83l-3.5-1.59"/></g></svg><span>班级管理</span></a>
                    }
                    @if (permissions.HasFlag(UserPermissions.ManageUsers))
                    {
                        <a class="@NavClass("/Users")" aria-current="@CurrentPage("/Users")" asp-page="/Users" data-search-label="人员与角色 人员权限 用户 账号管理 角色 批量导入"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M16 3.128a4 4 0 0 1 0 7.744M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/></g></svg><span>人员与角色</span></a>
                    }
                    </div>
                }
                @if (current.Role == UserRole.Admin || permissions.HasFlag(UserPermissions.ManageUsers))
                {
                    <div class="nav-group" data-nav-group="system">
                    <button class="nav-section-label" type="button" data-nav-group-toggle aria-expanded="true">系统</button>
                        <a class="@(systemSettingsActive ? "nav-link active" : "nav-link")" aria-current="@(systemSettingsActive ? "page" : null)" href="@(current.Role == UserRole.Admin ? Url.Page("/SystemConfig") : Url.Page("/LoginSettings"))" data-search-label="系统设置 系统配置 系统更新 备份 服务端维护 登录页设置 登录页 背景 访客访问 扫码登录 插件凭据 配对码 自动拉取课表"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M14 17H5M19 7h-9"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/></g></svg><span>系统设置</span></a>
                    </div>
                }
            </nav>
            @* 在首次绘制前还原分组折叠和侧边栏滚动位置，换页时侧边栏不再跳回顶部。 *@
            <script>(() => {
                const nav = document.currentScript.previousElementSibling;
                try {
                    const collapsed = JSON.parse(localStorage.getItem("remoteci-nav-collapsed") || "[]");
                    nav.querySelectorAll("[data-nav-group]").forEach(group => {
                        if (!collapsed.includes(group.dataset.navGroup) || group.querySelector(".nav-link.active")) return;
                        group.classList.add("collapsed");
                        group.querySelector("[data-nav-group-toggle]")?.setAttribute("aria-expanded", "false");
                    });
                    nav.scrollTop = Number(sessionStorage.getItem("remoteci-sidebar-scroll")) || 0;
                    const active = nav.querySelector(".nav-link.active");
                    if (active && (active.offsetTop < nav.scrollTop || active.offsetTop + active.offsetHeight > nav.scrollTop + nav.clientHeight)) active.scrollIntoView({ block: "nearest" });
                } catch { }
                addEventListener("pagehide", () => { try { sessionStorage.setItem("remoteci-sidebar-scroll", String(nav.scrollTop)); } catch { } });
            })();</script>
            <div class="sidebar-footer">
                <a class="sidebar-user" asp-page="/Account" aria-label="打开 @current.DisplayName 的个人账号" title="@current.DisplayName">
                    <span class="sidebar-user-avatar">@userInitial</span>
                    <span class="sidebar-user-copy"><strong>@current.DisplayName</strong><small>@current.Role</small></span>
                </a>
                <form class="logout-form" method="post" asp-page="/Logout">
                    <button class="logout-button" type="submit" title="退出登录"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m16 17l5-5l-5-5m5 5H9m0 9H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/></svg><span>退出登录</span></button>
                </form>
            </div>
        </aside>
        <div class="sidebar-backdrop" data-sidebar-backdrop></div>
        <div class="app-frame">
            <header class="topbar">
                <button class="topbar-button menu-button" type="button" data-sidebar-toggle aria-label="展开或收起导航" title="展开或收起导航"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5h16M4 12h16M4 19h16"/></svg></button>
                <div class="app-search" role="search">
                    <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m21 21l-4.34-4.34"/><circle cx="11" cy="11" r="8"/></g></svg>
                    <input type="search" data-app-search placeholder="搜索页面或功能" autocomplete="off" aria-label="搜索页面或功能" />
                    <span class="search-feedback" data-search-feedback aria-live="polite"></span>
                </div>
                <div class="topbar-actions">
                    @if (MobileUi.IsPhone(Context.Request) || Context.Request.Cookies[MobileUi.Cookie] == "desktop") { <a class="button ghost" href="?view=mobile">返回手机版</a> }
                    @if (accessibleClasses.Count > 1)
                    {
                        <form class="class-switcher" method="post" asp-page="/Account" asp-page-handler="SwitchClass">
                            <input type="hidden" name="returnUrl" value="@(currentPage ?? "/Index")" />
                            <svg class="switcher-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m6.08 9.5l-3.5 1.6a1 1 0 0 0 0 1.81l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9a1 1 0 0 0 0-1.83l-3.5-1.59"/><path d="m6.08 14.5l-3.5 1.6a1 1 0 0 0 0 1.81l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9a1 1 0 0 0 0-1.83l-3.5-1.59"/></g></svg>
                            @* 原生 select 的弹出列表由系统绘制，无法跟随主题；改用 details 菜单，每项直接提交表单。 *@
                            <details class="class-menu" data-class-menu>
                                <summary aria-label="切换班级" title="切换班级">
                                    <span class="class-menu-label">@currentClassName</span>
                                    <svg class="class-menu-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9l6 6l6-6"/></svg>
                                </summary>
                                <div class="class-menu-list" role="menu">
                                    @foreach (var classroom in accessibleClasses)
                                    {
                                        var isCurrentClass = classroom.Id == currentClassId;
                                        <button type="submit" name="classId" value="@classroom.Id" role="menuitemradio" aria-checked="@(isCurrentClass ? "true" : "false")" class="@(isCurrentClass ? "class-menu-item active" : "class-menu-item")">
                                            <span>@classroom.Name</span>
                                            <svg class="class-menu-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                                        </button>
                                    }
                                </div>
                            </details>
                        </form>
                    }
                    else if (accessibleClasses.Count == 1)
                    {
                        <span class="class-switcher current" title="当前班级"><svg class="switcher-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m6.08 9.5l-3.5 1.6a1 1 0 0 0 0 1.81l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9a1 1 0 0 0 0-1.83l-3.5-1.59"/><path d="m6.08 14.5l-3.5 1.6a1 1 0 0 0 0 1.81l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9a1 1 0 0 0 0-1.83l-3.5-1.59"/></g></svg><span>@currentClassName</span></span>
                    }
                    <a class="topbar-button notification-bell" asp-page="/Inbox" aria-label="通知" title="通知" data-notification-bell data-unread-url="@Url.Page("/Inbox", "Unread")"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M10.268 21a2 2 0 0 0 3.464 0M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/></g></svg><span class="bell-badge" data-unread-badge hidden="@(unreadNotifications == 0)">@(unreadNotifications > 99 ? "99+" : unreadNotifications.ToString())</span></a>
                    <button class="topbar-button" type="button" data-theme-toggle aria-label="切换明暗主题" title="切换明暗主题"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v2m2.837 12.385a6 6 0 1 1-7.223-7.222c.624-.147.97.66.715 1.248a4 4 0 0 0 5.26 5.259c.589-.255 1.396.09 1.248.715M16 12a4 4 0 0 0-4-4m7-3l-1.256 1.256M20 12h2"/></svg></button>
                    <button class="topbar-button" type="button" data-page-refresh aria-label="刷新当前页面" title="刷新当前页面"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></g></svg></button>
                    @* 头像菜单收拢个人账号与退出登录；系统级设置统一走侧边栏“系统设置”。 *@
                    <details class="account-menu" data-account-menu>
                        <summary class="user-avatar" aria-label="@current.DisplayName 的账号菜单" title="@current.DisplayName">@userInitial</summary>
                        <div class="account-menu-list" role="menu">
                            <div class="account-menu-head"><strong>@current.DisplayName</strong><small>@current.UserName</small></div>
                            <a class="account-menu-item" role="menuitem" asp-page="/Account">个人账号</a>
                            <form method="post" asp-page="/Logout"><button class="account-menu-item danger" role="menuitem" type="submit">退出登录</button></form>
                        </div>
                    </details>
                </div>
            </header>
            <main class="shell">
                @if (TempData["Message"] is string message) { <div class="flash">@message</div> }
                @if (TempData["Error"] is string error) { <div class="flash error">@error</div> }
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="shell auth-shell">
            @if (TempData["Message"] is string message) { <div class="flash">@message</div> }
            @if (TempData["Error"] is string error) { <div class="flash error">@error</div> }
            @RenderBody()
        </main>
    }
    @* 同步执行：在首次绘制前恢复 tab、滚动位置和未保存的选择；head 中的 rel=expect 让浏览器等到下面的标记解析完再绘制。 *@
    <script src="~/page-state.js" asp-append-version="true"></script>
    <span id="page-state-ready" hidden></span>
    <script src="~/app.js" asp-append-version="true" defer></script>
    <script src="~/voice-message.js" asp-append-version="true" defer></script>
    @if (current is not null && currentPage != "/Visitor")
    {
        <div class="toast-stack" data-toast-stack aria-live="polite"></div>
        <script src="~/notifications.js" asp-append-version="true" defer></script>
    }
</body>
</html>
