@model RemoteCI.Server.Pages.ExtensionFieldsModel
@using RemoteCI.Server.Pages
@if (!Model.HasLayout)
{
    @* 未声明分区/卡片的字段（扩展功能参数、旧插件）：保持逐字段堆叠的旧布局。 *@
    for (var index = 0; index < Model.Fields.Count; index++)
    {
        <partial name="_ExtensionField" model="new ExtensionFieldRender(Model, new ExtensionFieldSlot(index, Model.Fields[index]))" />
    }
}
else
{
    <div class="extension-fields" data-extension-fields>
        @foreach (var part in Model.BuildLayout())
        {
            var sectionVisible = part.Cards.Any(card => card.AllSlots.Any(slot => Model.IsVisible(slot.Field)));
            <section class="extension-section" data-extension-section hidden="@(!sectionVisible)">
                @if (part.Title is not null)
                {
                    <h3 class="extension-section-title">@part.Title</h3>
                }
                <div class="extension-section-body">
                    @foreach (var card in part.Cards)
                    {
                        var cardVisible = card.AllSlots.Any(slot => Model.IsVisible(slot.Field));
                        if (card.Title is null)
                        {
                            <div class="extension-card extension-card-single" data-extension-card hidden="@(!cardVisible)">
                                @foreach (var slot in card.Items)
                                {
                                    <partial name="_ExtensionField" model="new ExtensionFieldRender(Model, slot)" />
                                }
                            </div>
                        }
                        else
                        {
                            var hasBody = card.Items.Count > 0;
                            var bodyId = $"{Model.IdPrefix}-card-{card.AllSlots.Min(slot => slot.Index)}";
                            <div class="extension-card" data-extension-card hidden="@(!cardVisible)">
                                <div class="extension-card-head@(hasBody ? " is-expandable" : "")"
                                     data-card-expand="@(hasBody ? bodyId : null)" role="@(hasBody ? "button" : null)"
                                     tabindex="@(hasBody ? "0" : null)" aria-expanded="@(hasBody ? "false" : null)" aria-controls="@(hasBody ? bodyId : null)">
                                    <div class="extension-card-title">
                                        <strong>@card.Title</strong>
                                        @if (card.Description is not null)
                                        {
                                            <small class="muted">@card.Description</small>
                                        }
                                    </div>
                                    @if (card.Toggle is { } headerToggle)
                                    {
                                        <div class="extension-card-toggle" data-card-toggle-slot>
                                            <partial name="_ExtensionField" model="new ExtensionFieldRender(Model, headerToggle, true)" />
                                        </div>
                                    }
                                    @if (hasBody)
                                    {
                                        <i class="icon icon-expand-more extension-card-chevron" aria-hidden="true"></i>
                                    }
                                </div>
                                @if (hasBody)
                                {
                                    <div class="extension-card-body" id="@bodyId" hidden>
                                        @foreach (var slot in card.Items)
                                        {
                                            <partial name="_ExtensionField" model="new ExtensionFieldRender(Model, slot)" />
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </section>
        }
    </div>
}
