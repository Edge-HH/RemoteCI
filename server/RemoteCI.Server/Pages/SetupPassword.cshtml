@page
@model SetupPasswordModel
@{
    ViewData["Title"] = "设置密码";
}
<div class="page-head">
    <div>
        <p class="eyebrow">首次登录</p>
        <h1>设置密码</h1>
    </div>
</div>
<p class="muted" style="margin-bottom:18px">账号 <strong>@Model.Username</strong> 尚未设置密码，请设置登录密码。</p>

<section class="panel">
    <form method="post" class="stack">
        <input type="hidden" asp-for="SetupToken" />
        <input type="hidden" asp-for="Username" />
        <label>新密码<input asp-for="NewPassword" type="password" autocomplete="new-password" /></label>
        <label>确认新密码<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" /></label>
        <button type="submit">保存并返回登录</button>
    </form>
</section>
