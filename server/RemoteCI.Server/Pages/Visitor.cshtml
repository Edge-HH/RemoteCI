@page
@model VisitorModel
@{ ViewData["Title"] = "课表"; }
<header class="visitor-head">
    <div>
        <p class="eyebrow">访客查看</p>
        <h1>课表</h1>
        <p class="muted">只读浏览当前课表，登录后可管理课堂。</p>
    </div>
    <a class="ghost button" asp-page="/Login" asp-route-from="visitor">返回登录</a>
</header>
@if (Model.VisitorClasses.Count > 0)
{
    <nav class="class-switcher visitor-switcher" aria-label="选择班级">
        @foreach (var classroom in Model.VisitorClasses)
        {
            <a class="class-chip@(classroom.Id == Model.CurrentClassId ? " active" : string.Empty)"
               asp-page="/Visitor" asp-route-class="@classroom.Id">
                @if (classroom.Avatar is not null)
                {
                    <img class="class-avatar small" src="/api/classes/@classroom.Id/avatar" alt="" />
                }
                @classroom.Name
            </a>
        }
    </nav>
}
@if (Model.Bundle is null)
{
    <div class="notice warning">插件尚未同步课表。</div>
}
else
{
    <partial name="_ScheduleTable" model="Model.Bundle" />
}
