@page
@model ControlModel
@{
    ViewData["Title"] = "控制";
    var snapshot = Model.Snapshot;
    var mainMenuVisible = snapshot?.IsMainMenuVisible ?? true;
    var volumeAvailable = snapshot?.IsVolumeControlAvailable == true;
}
<div class="page-head">
    <div>
        <p class="eyebrow">ClassIsland 远程操作</p>
        <h1>控制</h1>
    </div>
    <span class="status @(Model.PluginOnline ? "online" : "offline")">@(Model.PluginOnline ? "插件在线" : "插件离线")</span>
</div>

@await Html.PartialAsync("_BatchResults", Model)

@* 复用批量控制页的动作卡片与参数弹窗；SingleControl 模式下目标固定为当前班级。 *@
@await Html.PartialAsync("_BatchControlActions", Model)

@* 班级控制页独有、且无需填写参数的操作：点击后直接执行或跳到下方编辑区。 *@
<section class="panel batch-section control-command-section" aria-labelledby="control-extra-actions-title">
    <div class="panel-heading"><div><h2 id="control-extra-actions-title">当前班级</h2></div></div>
    <div class="batch-action-grid">
        @if (Model.CanControlMainMenu)
        {
            <form method="post" asp-page-handler="MainMenu" class="batch-action-card-form">
                <input type="hidden" name="visible" value="@(!mainMenuVisible ? "true" : "false")" />
                <button type="submit" class="batch-action-card" disabled="@(!Model.PluginOnline)"><span class="batch-action-icon"><i class="bi @(mainMenuVisible ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i></span><span class="batch-action-copy"><strong>@(mainMenuVisible ? "隐藏主界面" : "显示主界面")</strong><small>切换设备上的 ClassIsland 主界面。</small></span></button>
            </form>
        }
        @if (Model.CanTeacherComing)
        {
            <form method="post" asp-page-handler="TeacherComing" class="batch-action-card-form">
                <button type="submit" class="batch-action-card" disabled="@(!Model.PluginOnline)"><span class="batch-action-icon"><i class="bi bi-mortarboard" aria-hidden="true"></i></span><span class="batch-action-copy"><strong>老师来了</strong><small>发送快捷提醒。</small></span></button>
            </form>
        }
        @if (Model.CanControlVolume)
        {
            <button type="button" class="batch-action-card" data-user-edit-open="volume-dialog" aria-controls="volume-dialog"><span class="batch-action-icon"><i class="bi bi-volume-up" aria-hidden="true"></i></span><span class="batch-action-copy"><strong>音量调节</strong><small>调节设备音量或静音。</small></span></button>
        }
        @if (Model.CanManageClassInfo)
        {
            <button type="button" class="batch-action-card" data-user-edit-open="class-info-dialog" aria-controls="class-info-dialog"><span class="batch-action-icon"><i class="bi bi-collection" aria-hidden="true"></i></span><span class="batch-action-copy"><strong>班级设置</strong><small>修改班级名称与头像。</small></span></button>
        }
    </div>
</section>

@if (Model.CanManageClassInfo)
{
    <dialog id="class-info-dialog" class="user-edit-dialog" data-user-edit-dialog aria-labelledby="class-info-dialog-title">
        <div class="user-edit-dialog-shell">
            <header class="user-edit-dialog-header"><div><p class="eyebrow">当前班级</p><h2 id="class-info-dialog-title">班级设置</h2><p class="muted">头像会显示在选班页、访客页与客户端班级列表。</p></div><button type="button" class="ghost dialog-close-button" data-user-edit-close aria-label="关闭班级设置"><i class="bi bi-x-lg" aria-hidden="true"></i></button></header>
            <div class="class-info-body user-edit-form">
                @if (Model.HasAvatar)
                {
                    <img class="class-avatar" src="/api/classes/@Model.CurrentClassId/avatar" alt="班头像" />
                }
                <form method="post" asp-page-handler="ClassInfo" class="stack">
                    <label>班名<input asp-for="ClassNameInput" maxlength="40" placeholder="@Model.CurrentClass?.Name" /></label>
                    <button type="submit">保存班名</button>
                </form>
                <form method="post" asp-page-handler="Avatar" enctype="multipart/form-data" class="stack">
                    <label>班头像（PNG/JPEG/WebP，≤256KB）<input type="file" asp-for="AvatarFile" accept="image/png,image/jpeg,image/webp" /></label>
                    <button type="submit">上传头像</button>
                </form>
                @if (Model.HasAvatar)
                {
                    <form method="post" asp-page-handler="RemoveAvatar">
                        <button type="submit" class="ghost">清除头像</button>
                    </form>
                }
            </div>
        </div>
    </dialog>
}

@if (Model.CanControlVolume)
{
    <dialog id="volume-dialog" class="user-edit-dialog" data-user-edit-dialog aria-labelledby="volume-dialog-title">
        <div class="user-edit-dialog-shell">
            <header class="user-edit-dialog-header"><div><p class="eyebrow"><i class="bi @(snapshot?.IsMuted == true ? "bi-volume-mute" : "bi-volume-up")" aria-hidden="true" data-volume-icon></i> 当前班级</p><h2 id="volume-dialog-title">音量调节</h2><p class="muted" data-volume-summary>当前音量 @(snapshot?.VolumePercent ?? 0)% · @(snapshot?.IsMuted == true ? "已静音" : "未静音")</p></div><button type="button" class="ghost dialog-close-button" data-user-edit-close aria-label="关闭音量调节"><i class="bi bi-x-lg" aria-hidden="true"></i></button></header>
            <div class="control-actions user-edit-form">
                <form method="post" asp-page-handler="Volume" class="volume-form" data-volume-form>
                    <label>Windows 主音量
                        <span class="range-field">
                            <input asp-for="VolumeLevel" type="range" min="0" max="100"
                                   data-volume-slider data-muted="@(snapshot?.IsMuted == true ? "true" : "false")"
                                   disabled="@(!Model.PluginOnline || !volumeAvailable)" />
                            <output data-volume-output>@Model.VolumeLevel%</output>
                        </span>
                    </label>
                    <span class="control-note" data-volume-feedback aria-live="polite">拖动后自动应用</span>
                </form>
                <form method="post" asp-page-handler="Mute" data-mute-form>
                    <input type="hidden" name="muted" value="@(snapshot?.IsMuted != true ? "true" : "false")" />
                    <button class="ghost" type="submit" data-mute-button disabled="@(!Model.PluginOnline || !volumeAvailable)">@(snapshot?.IsMuted == true ? "取消静音" : "静音")</button>
                </form>
            </div>
            @if (!volumeAvailable)
            {
                <p class="control-note">插件尚未报告可用的 Windows 默认播放设备。</p>
            }
        </div>
    </dialog>
}

<div class="control-grid">
    @if (Model.CanSendNotifications && Model.ShowBroadcast)
    {
        <section class="panel control-card control-card-full" id="broadcast-notification">
            <div class="panel-heading">
                <div><h2>广播通知（集控）</h2><p class="muted">向多个班级同时发送通知。</p></div>
            </div>
            <form method="post" asp-page-handler="Broadcast" class="stack">
                <label>标题<input asp-for="BroadcastInput.Title" maxlength="60" placeholder="RemoteCI 通知" /></label>
                <label>正文<textarea asp-for="BroadcastInput.Message" maxlength="500" rows="3"></textarea></label>
                <div class="two-column">
                    <label>持续时间（秒）<input asp-for="BroadcastInput.DurationSeconds" type="number" min="1" max="3600" value="5" /></label>
                    <label>重复次数<input asp-for="BroadcastInput.RepeatCounts" type="number" min="1" max="10" value="1" /></label>
                </div>
                <fieldset class="batch-check-group">
                    <legend>提醒选项</legend>
                    <label class="check"><input type="checkbox" asp-for="BroadcastInput.IsSpeechEnabled" /> 启用语音</label>
                    <label class="check"><input type="checkbox" asp-for="BroadcastInput.IsNotificationSoundEnabled" /> 启用提醒音效</label>
                    <label class="check"><input type="checkbox" asp-for="BroadcastInput.IsNotificationEffectEnabled" /> 启用提醒特效</label>
                    <label class="check"><input type="checkbox" asp-for="BroadcastInput.IsNotificationTopmostEnabled" /> 提醒时置顶主界面</label>
                </fieldset>
                <p class="muted">重复次数让正文横向滚动指定遍数，总显示时长为“持续时间 × 重复次数”。</p>
                <div class="broadcast-targets" aria-label="选择要通知的班级">
                    @foreach (var target in Model.BroadcastTargets)
                    {
                        <label class="check">
                            <input type="checkbox" name="BroadcastClassIds" value="@target.Id" />
                            @target.Name
                            @if (target.GroupNames is { Count: > 0 })
                            {
                                foreach (var groupName in target.GroupNames)
                                {
                                    <span class="group-name">@groupName</span>
                                }
                            }
                        </label>
                    }
                </div>
                <div>
                    <button type="submit">广播到勾选的 @Model.BroadcastTargets.Count 个班级</button>
                </div>
            </form>
        </section>
    }

    @if (Model.CanUseExtensions)
    {
        <section class="panel control-card control-card-full" id="extensions">
            <div class="control-card-head">
                <span class="feature-icon"><i class="bi bi-puzzle" aria-hidden="true"></i></span>
                <div><h2>扩展功能</h2><p class="muted">由其他 ClassIsland 插件注册的功能。</p></div>
            </div>
            <div class="extension-list">
                @if (Model.Extensions.Count == 0)
                {
                    <p class="muted">当前没有向此账号开放的扩展功能。</p>
                }
                @{ var extensionIndex = 0; }
                @foreach (var item in Model.Extensions)
                {
                    var extension = item.Definition;
                    var runDialogId = $"extension-run-{extensionIndex}";
                    var editDialogId = $"extension-edit-{extensionIndex}";
                    <article class="extension-control-row">
                        <div class="extension-identity"><strong>@extension.DisplayName</strong><small>ID：@extension.Id</small></div>
                        <div class="extension-row-actions">
                            @if ((extension.Parameters?.Count ?? 0) == 0)
                            {
                                <form method="post" asp-page-handler="Extension">
                                    <input type="hidden" name="extensionId" value="@extension.Id" />
                                    <button type="submit" disabled="@(!Model.PluginOnline || !item.CanInvoke)">执行</button>
                                </form>
                            }
                            else
                            {
                                <button type="button" disabled="@(!Model.PluginOnline || !item.CanInvoke)" data-user-edit-open="@runDialogId" aria-controls="@runDialogId">执行</button>
                            }
                            <button class="ghost" type="button" data-user-edit-open="@editDialogId" aria-controls="@editDialogId">编辑</button>
                        </div>
                    </article>

                    @if ((extension.Parameters?.Count ?? 0) > 0)
                    {
                        <dialog id="@runDialogId" class="user-edit-dialog" data-user-edit-dialog aria-labelledby="@($"{runDialogId}-title")">
                            <div class="user-edit-dialog-shell">
                                <header class="user-edit-dialog-header"><div><p class="eyebrow">执行扩展</p><h2 id="@($"{runDialogId}-title")">@extension.DisplayName</h2><small>ID：@extension.Id</small></div><button type="button" class="ghost dialog-close-button" data-user-edit-close aria-label="关闭执行窗口"><i class="bi bi-x-lg" aria-hidden="true"></i></button></header>
                                <form method="post" asp-page-handler="Extension" class="stack extension-dialog-form">
                                    <input type="hidden" name="extensionId" value="@extension.Id" />
                                    @for (var parameterIndex = 0; parameterIndex < extension.Parameters!.Count; parameterIndex++)
                                    {
                                        var parameter = extension.Parameters[parameterIndex];
                                        <input type="hidden" name="ExtensionInputs[@parameterIndex].Key" value="@parameter.Key" />
                                        <label>@parameter.Label
                                            @if (parameter.Type == ExtensionParameterType.Switch)
                                            {
                                                <select name="ExtensionInputs[@parameterIndex].Value">
                                                    <option value="false" selected="@(!string.Equals(parameter.DefaultValue, "true", StringComparison.OrdinalIgnoreCase))">关闭</option>
                                                    <option value="true" selected="@(string.Equals(parameter.DefaultValue, "true", StringComparison.OrdinalIgnoreCase))">开启</option>
                                                </select>
                                            }
                                            else if (parameter.Type == ExtensionParameterType.Select)
                                            {
                                                <select name="ExtensionInputs[@parameterIndex].Value" required="@parameter.Required">
                                                    @if (!parameter.Required) { <option value="">未选择</option> }
                                                    @foreach (var option in parameter.Options ?? [])
                                                    {
                                                        <option value="@option" selected="@(option == parameter.DefaultValue)">@option</option>
                                                    }
                                                </select>
                                            }
                                            else
                                            {
                                                <input name="ExtensionInputs[@parameterIndex].Value" type="@(parameter.Type == ExtensionParameterType.Number ? "number" : "text")" value="@parameter.DefaultValue" required="@parameter.Required" />
                                            }
                                        </label>
                                    }
                                    <div class="dialog-actions"><button type="button" class="ghost" data-user-edit-close>取消</button><button type="submit">执行</button></div>
                                </form>
                            </div>
                        </dialog>
                    }

                    <dialog id="@editDialogId" class="user-edit-dialog" data-user-edit-dialog aria-labelledby="@($"{editDialogId}-title")">
                        <div class="user-edit-dialog-shell">
                            <header class="user-edit-dialog-header"><div><p class="eyebrow">扩展设置</p><h2 id="@($"{editDialogId}-title")">@extension.DisplayName</h2><small>ID：@extension.Id</small></div><button type="button" class="ghost dialog-close-button" data-user-edit-close aria-label="关闭编辑窗口"><i class="bi bi-x-lg" aria-hidden="true"></i></button></header>
                            @if (Model.IsAdmin)
                            {
                                <form method="post" asp-page-handler="ExtensionPolicy" class="stack extension-dialog-form">
                                    <input type="hidden" name="extensionId" value="@extension.Id" />
                                    <label class="check"><input type="checkbox" name="enabled" value="true" checked="@item.Enabled" /> 启用扩展功能</label>
                                    <label class="check"><input type="checkbox" name="allowNonAdmin" value="true" checked="@item.AllowNonAdmin" /> 对非管理员用户开放</label>
                                    <label class="check"><input type="checkbox" name="showOnWatch" value="true" checked="@item.ShowOnWatch" /> 在我自己的手表上展示</label>
                                    <p class="muted">关闭后所有账号都不能执行；开放后，普通账号还需拥有“扩展功能”权限。</p>
                                    <div class="dialog-actions"><button type="button" class="ghost" data-user-edit-close>取消</button><button type="submit">保存设置</button></div>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="ExtensionPreference" class="stack extension-dialog-form">
                                    <input type="hidden" name="extensionId" value="@extension.Id" />
                                    <label class="check"><input type="checkbox" name="showOnWatch" value="true" checked="@item.ShowOnWatch" /> 在我自己的手表上展示</label>
                                    <p class="muted">只影响你自己的手表。</p>
                                    <div class="dialog-actions"><button type="button" class="ghost" data-user-edit-close>取消</button><button type="submit">保存设置</button></div>
                                </form>
                            }
                        </div>
                    </dialog>
                    extensionIndex++;
                }
            </div>
        </section>
    }
</div>
