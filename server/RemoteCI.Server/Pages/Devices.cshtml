@page
@model DevicesModel
@{
    ViewData["Title"] = "设备状态";
}
<link rel="stylesheet" href="~/operations.css" asp-append-version="true" />
<div class="page-head">
    <div>
        <p class="eyebrow">服务端管理</p>
        <h1>设备状态</h1>
    </div>
    <a class="button ghost" asp-page="/SystemConfig" asp-fragment="device-alerts">离线告警设置</a>
</div>
<form method="get" class="panel ops-filters device-filters" data-device-filters>
    <label>分组
        <select name="group" onchange="this.form.submit()">
            <option value="">全部分组</option>
            @foreach (var group in Model.GroupOptions)
            {
                <option value="@group" selected="@(Model.Group == group)">@group</option>
            }
        </select>
    </label>
    <label class="check"><input type="checkbox" name="offlineOnly" value="true" checked="@Model.OfflineOnly" onchange="this.form.submit()" /> 只看离线设备</label>
</form>
<div data-device-grid data-refresh-url="@Url.Page("/Devices", "Grid", new { group = Model.Group, offlineOnly = Model.OfflineOnly })">
    <partial name="_DeviceGrid" model="Model" />
</div>
<dialog id="screenshot-dialog" class="user-edit-dialog screenshot-dialog" data-user-edit-dialog data-screenshot-dialog
        data-capture-url="@Url.Page("/Devices", "Screenshot")" aria-labelledby="screenshot-dialog-title">
    <div class="user-edit-dialog-shell">
        <header class="user-edit-dialog-header"><div><p class="eyebrow" data-screenshot-target-name>教室电脑</p><h2 id="screenshot-dialog-title">屏幕截图</h2><p class="muted">截取该设备全部显示器的当前画面，保留 24 小时；每次截图都会写入操作记录。</p></div><button type="button" class="ghost dialog-close-button" data-user-edit-close aria-label="关闭屏幕截图"><i class="icon icon-close" aria-hidden="true"></i></button></header>
        <div class="user-edit-form screenshot-body">
            <form method="post" class="screenshot-actions" data-screenshot-form>
                @Html.AntiForgeryToken()
                <button type="submit" data-screenshot-capture>立即截图</button>
                <span class="control-note" data-screenshot-status aria-live="polite"></span>
            </form>
            <figure class="screenshot-preview" data-screenshot-preview hidden>
                <a data-screenshot-open target="_blank" rel="noopener"><img data-screenshot-image alt="教室电脑屏幕截图" /></a>
                <figcaption><span data-screenshot-caption></span> <a data-screenshot-download>下载</a></figcaption>
            </figure>
        </div>
    </div>
</dialog>
<script src="~/devices.js" asp-append-version="true"></script>
<script src="~/screenshot.js" asp-append-version="true" defer></script>
