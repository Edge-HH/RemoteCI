@page
@model UsersModel
@{
    ViewData["Title"] = "人员权限";
    var createIsAdmin = Model.Create.Role == UserRole.Admin;
    var createIsTeacher = Model.Create.RoleId == AccountRole.TeacherId;
}
<div class="page-head">
    <div>
        <p class="eyebrow">账号与权限</p>
        <h1>人员管理</h1>
    </div>
</div>

@if (Model.CreatedApiKey is { } createdApiKey)
{
    <section class="panel api-key-reveal-panel">
        <div class="panel-heading">
            <div>
                <h2>API Key 已生成</h2>
                <p class="muted">密钥只显示一次，请立即复制并通过安全渠道交给目标账号。</p>
            </div>
        </div>
        <div class="api-key-reveal" role="status">
            <div>
                <strong>@createdApiKey.Username · @createdApiKey.ApiKey.Name</strong>
                <p>创建时间 @createdApiKey.ApiKey.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
            </div>
            <div class="api-key-secret">
                <code>@createdApiKey.Key</code>
                <button type="button" class="ghost" data-copy-value="@createdApiKey.Key" aria-label="复制 API Key" title="复制 API Key"><i class="bi bi-copy" aria-hidden="true"></i></button>
            </div>
        </div>
    </section>
}

<section class="panel">
    <h2>访客访问</h2>
    <p class="muted">在<a asp-page="/Classes">班级管理</a>中逐班开启访客功能后，登录页会出现“仅查看”，访客只能浏览开放班级的课表。</p>
    <form method="post" asp-page-handler="VisitorAccess" class="stack">
        <label class="check"><input asp-for="AutoEnterVisitorPage" /> 自动进入访客页</label>
        <button type="submit">保存访客设置</button>
    </form>
</section>
@if (Model.CurrentUser.Role == UserRole.Admin)
{
<section class="panel member-excel-panel">
    <div class="panel-heading">
        <div>
            <h2>批量导入与导出</h2>
            <p class="muted">普通导入只新增账号；覆盖导入使用 RemoteCI 导出的 Excel 更新成员关系，不会修改密码。</p>
        </div>
    </div>
    <div class="member-excel-grid">
        <article class="member-excel-card">
            <h3>1. 下载模板</h3>
            <p>模板包含“用户 ID、用户名、班级、角色、密码”五列。密码可留空，账号首次登录时会要求设置密码。</p>
            <a class="button" asp-page-handler="Template">下载 Excel 模板</a>
        </article>
        <article class="member-excel-card">
            <h3>2. 导入新成员</h3>
            <p>填写模板后上传。已存在的用户 ID、非法字段或文件内重复项会逐条列出，其他合法行仍会导入。</p>
            <form method="post" asp-page-handler="ImportExcel" enctype="multipart/form-data" class="stack">
                <label>填写后的 Excel<input type="file" name="excelFile" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required /></label>
                <button type="submit">上传并导入</button>
            </form>
        </article>
        <article class="member-excel-card">
            <h3>3. 导出并覆盖修改</h3>
            <p>导出文件不含密码列。可修改用户名、班级和班级角色，再上传同一文件覆盖导出范围内的成员关系。</p>
            <form method="get" asp-page-handler="Export" class="stack">
                <label>导出范围
                    <select name="groupId">
                        <option value="">全部班级</option>
                        @foreach (var group in Model.ImportGroups)
                        {
                            <option value="@group.Id">@(string.Concat(Enumerable.Repeat("　", Math.Max(0, group.Depth - 1))) + group.Name)</option>
                        }
                    </select>
                </label>
                <button type="submit">导出 Excel</button>
            </form>
            <form method="post" asp-page-handler="OverwriteExcel" enctype="multipart/form-data" class="stack">
                <label>修改后的导出文件<input type="file" name="excelFile" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required /></label>
                <button type="submit" class="ghost" onclick="return confirm('覆盖导入会按导出范围替换成员关系，确定继续吗？')">上传并覆盖</button>
            </form>
        </article>
    </div>

    @if (Model.ExcelImportResult is { } report)
    {
        <div class="member-import-result">
            <div class="notice @(report.HasFailures ? "warning" : "ok")">
                <div>
                    <strong>@(report.Overwrite ? "覆盖导入结果" : "导入结果")</strong>
                    <span>@report.Summary</span>
                </div>
            </div>
            @if (report.HasFailures)
            {
                <div class="user-account-table-wrap member-import-failures">
                    <table class="user-account-table">
                        <thead><tr><th scope="col">Excel 行</th><th scope="col">用户 ID</th><th scope="col">失败原因</th></tr></thead>
                        <tbody>
                        @foreach (var failure in report.Failures)
                        {
                            <tr>
                                <td data-label="Excel 行">@failure.RowNumber</td>
                                <td data-label="用户 ID"><code>@failure.Username</code></td>
                                <td data-label="失败原因">@failure.Message</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <details class="member-text-import">
        <summary>文本导入（兼容旧格式）</summary>
        <p class="muted">每行一个账号：<code>ID,用户名,班级,角色,密码</code>，逗号或制表符分隔，# 开头的行忽略。班级不存在会自动创建；密码可留空，首次登录时设置。旧 3 列格式 <code>ID,用户名,密码</code> 使用下方的默认班级与角色。</p>
        <form method="post" asp-page-handler="BatchImport" class="stack">
            <label>账号清单<textarea asp-for="ImportText" rows="6" placeholder="zhang.san,张三,高一（1）班,学生,&#10;li.si,李四,高一（1）班,班主任,Passw0rd-2026&#10;wang.wu,王五,高一（2）班,学生,"></textarea></label>
            <label>默认班级（仅 3 列旧格式行使用）
                <select asp-for="ImportClassId">
                    <option value="">（不导入 3 列旧格式行）</option>
                    @foreach (var classroom in Model.Classes)
                    {
                        <option value="@classroom.Id">@classroom.Name</option>
                    }
                </select>
            </label>
            <label>默认角色（仅 3 列旧格式行使用）
                <select asp-for="ImportRoleId">
                    @foreach (var role in Model.RoleDefinitions.Where(x => x.Kind != nameof(AccountRoleKind.Administrator)))
                    {
                        <option value="@role.Id" selected="@(role.Id == AccountRole.StudentId)">@role.Name</option>
                    }
                </select>
            </label>
            <button type="submit">批量导入</button>
        </form>
    </details>
</section>
<section class="panel">
    <div class="panel-heading">
        <div><h2>角色配置</h2><p class="muted">默认权限对该角色的所有账号生效。</p></div>
        <button type="button" data-user-edit-open="role-create-dialog" aria-controls="role-create-dialog">创建角色</button>
    </div>
    <div class="user-account-table-wrap">
        <table class="user-account-table role-summary-table">
            <thead><tr><th scope="col">角色名称</th><th scope="col"><span class="visually-hidden">操作</span></th></tr></thead>
            <tbody>
            @foreach (var role in Model.RoleDefinitions)
            {
                var dialogId = $"role-edit-{role.Id:N}";
                <tr><td data-label="角色名称"><strong>@role.Name</strong></td><td class="user-account-action"><button type="button" class="ghost user-edit-button" data-user-edit-open="@dialogId" aria-controls="@dialogId">编辑</button></td></tr>
            }
            </tbody>
        </table>
    </div>

    @foreach (var role in Model.RoleDefinitions)
    {
        var dialogId = $"role-edit-{role.Id:N}";
        var locked = role.Kind == "Administrator";
        <dialog id="@dialogId" class="user-edit-dialog" data-user-edit-dialog aria-labelledby="@($"{dialogId}-title")">
            <div class="user-edit-dialog-shell">
                <header class="user-edit-dialog-header"><div><p class="eyebrow">编辑角色</p><h2 id="@($"{dialogId}-title")">@role.Name</h2><small>@role.UserCount 个账号正在使用</small></div><button type="button" class="ghost dialog-close-button" data-user-edit-close aria-label="关闭编辑窗口"><i class="bi bi-x-lg" aria-hidden="true"></i></button></header>
                @if (locked)
                {
                    <div class="role-dialog-body"><p class="admin-permission-note">管理员固定拥有全部权限，不可修改。</p><div class="dialog-actions"><button type="button" class="ghost" data-user-edit-close>关闭</button></div></div>
                }
                else
                {
                    <form method="post" asp-page-handler="UpdateRole" class="stack role-edit-dialog-form"><input type="hidden" name="RoleEdit.Id" value="@role.Id" /><label>角色名称<input name="RoleEdit.Name" value="@role.Name" readonly="@(role.Kind != "Custom")" /></label><fieldset class="permissions"><legend>默认权限</legend><label><input type="checkbox" name="RoleEdit.AccessWebUi" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.AccessWebUi)" /> 概览</label><label><input type="checkbox" name="RoleEdit.ManageUsers" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.ManageUsers)" /> 人员管理</label><label><input type="checkbox" name="RoleEdit.SendNotifications" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.SendNotifications)" /> 发送与清除通知</label><label><input type="checkbox" name="RoleEdit.SendVoiceMessages" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.SendVoiceMessages)" /> 发送语音</label><label><input type="checkbox" name="RoleEdit.TeacherComing" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.TeacherComing)" /> 老师来了</label><label><input type="checkbox" name="RoleEdit.ManageSchedule" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.ManageSchedule)" /> 换课</label><label><input type="checkbox" name="RoleEdit.RunExtensions" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.RunExtensions)" /> 扩展功能</label><label><input type="checkbox" name="RoleEdit.MainMenuControl" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.MainMenuControl)" /> 主界面</label><label><input type="checkbox" name="RoleEdit.PowerControl" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.PowerControl)" /> 电源控制</label><label><input type="checkbox" name="RoleEdit.ChangeDisplayName" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.ChangeDisplayName)" /> 修改用户名</label><label><input type="checkbox" name="RoleEdit.ApiAccess" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.ApiAccess)" /> API 访问</label><label title="老师可发起换课申请，由对方老师审批"><input type="checkbox" name="RoleEdit.RequestScheduleSwap" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.RequestScheduleSwap)" /> 老师主动换课</label><label title="不经审批立即换课，对方老师可撤回"><input type="checkbox" name="RoleEdit.ForceScheduleSwap" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.ForceScheduleSwap)" /> 强制换课</label></fieldset><div class="dialog-actions"><button type="button" class="ghost" data-user-edit-close>取消</button><button type="submit">保存角色</button></div></form>
                    @if (role.Kind == "Custom") { <section class="user-danger-zone"><div><h3>删除角色</h3><p>只有未被账号使用的角色才能删除。</p></div><form method="post" asp-page-handler="DeleteRole" class="delete-user-form" onsubmit="return confirm('确定删除此角色？')"><input type="hidden" name="id" value="@role.Id" /><button type="submit" class="danger ghost">删除角色</button></form></section> }
                }
            </div>
        </dialog>
    }

    <dialog id="role-create-dialog" class="user-edit-dialog" data-user-edit-dialog aria-labelledby="role-create-dialog-title">
        <div class="user-edit-dialog-shell"><header class="user-edit-dialog-header"><div><p class="eyebrow">新建角色</p><h2 id="role-create-dialog-title">创建角色</h2></div><button type="button" class="ghost dialog-close-button" data-user-edit-close aria-label="关闭创建窗口"><i class="bi bi-x-lg" aria-hidden="true"></i></button></header><form method="post" asp-page-handler="CreateRole" class="stack role-edit-dialog-form"><label>角色名称<input name="RoleEdit.Name" maxlength="40" required /></label><fieldset class="permissions"><legend>默认权限</legend><label><input type="checkbox" name="RoleEdit.AccessWebUi" value="true" /> 概览</label><label><input type="checkbox" name="RoleEdit.ManageUsers" value="true" /> 人员管理</label><label><input type="checkbox" name="RoleEdit.SendNotifications" value="true" /> 发送与清除通知</label><label><input type="checkbox" name="RoleEdit.SendVoiceMessages" value="true" /> 发送语音</label><label><input type="checkbox" name="RoleEdit.TeacherComing" value="true" /> 老师来了</label><label><input type="checkbox" name="RoleEdit.ManageSchedule" value="true" /> 换课</label><label><input type="checkbox" name="RoleEdit.RunExtensions" value="true" /> 扩展功能</label><label><input type="checkbox" name="RoleEdit.MainMenuControl" value="true" /> 主界面</label><label><input type="checkbox" name="RoleEdit.PowerControl" value="true" /> 电源控制</label><label><input type="checkbox" name="RoleEdit.ApiAccess" value="true" /> API 访问</label><label title="老师可发起换课申请，由对方老师审批"><input type="checkbox" name="RoleEdit.RequestScheduleSwap" value="true" checked /> 老师主动换课</label><label title="不经审批立即换课，对方老师可撤回"><input type="checkbox" name="RoleEdit.ForceScheduleSwap" value="true" /> 强制换课</label></fieldset><div class="dialog-actions"><button type="button" class="ghost" data-user-edit-close>取消</button><button type="submit">创建角色</button></div></form></div>
    </dialog>
</section>
}

<section class="panel">
    <h2>新建账号</h2>
    <form method="post" asp-page-handler="Create" class="form-grid" data-async-user-create data-role-form>
        <div class="form-error error" data-create-user-error role="alert" hidden></div>
        <label>ID<input asp-for="Create.Username" autocomplete="off" /></label>
        <label>账号名<input asp-for="Create.DisplayName" autocomplete="off" /><small class="muted teacher-username-note" data-teacher-username-note hidden>用户名会影响老师获取的日程信息。</small></label>
        <label>初始密码<input asp-for="Create.Password" type="password" autocomplete="new-password" /></label>
        <label>
            角色
            <select asp-for="Create.RoleId" data-role-select>
                @foreach (var role in Model.RoleDefinitions.Where(role => Model.CurrentUser.Role == UserRole.Admin || role.Kind != "Administrator")) { <option value="@role.Id" data-admin="@(role.Kind == "Administrator" ? "true" : "false")" data-teacher="@(role.Kind == AccountRoleKind.Teacher.ToString() ? "true" : "false")" selected="@(role.Id == Model.Create.RoleId)">@role.Name</option> }
            </select>
        </label>
        <label class="create-class-field" data-create-class-field hidden="@(createIsAdmin || createIsTeacher)">
            班级
            <select asp-for="Create.ClassId" data-create-class-select required="@(!createIsAdmin && !createIsTeacher)" disabled="@createIsTeacher">
                @foreach (var classroom in Model.Classes)
                {
                    <option value="@classroom.Id">@classroom.Name</option>
                }
            </select>
        </label>
        <p class="muted create-teacher-note" data-create-teacher-note hidden="@(!createIsTeacher)">老师账号按用户名自动关联课表中任教的班级。</p>
        <fieldset class="permissions" data-role-permissions hidden="@createIsAdmin">
            <legend>附加权限</legend>
            <label><input asp-for="Create.AccessWebUi" disabled="@createIsAdmin" /> 概览</label>
            <label><input asp-for="Create.ManageUsers" disabled="@createIsAdmin" /> 人员管理</label>
            <label><input asp-for="Create.SendNotifications" disabled="@createIsAdmin" /> 发送与清除通知</label><label><input asp-for="Create.SendVoiceMessages" disabled="@createIsAdmin" /> 发送语音</label>
            <label><input asp-for="Create.TeacherComing" disabled="@createIsAdmin" /> 老师来了</label>
            <label><input asp-for="Create.ManageSchedule" disabled="@createIsAdmin" /> 换课</label>
            <label><input asp-for="Create.RunExtensions" disabled="@createIsAdmin" /> 扩展功能</label>
            <label><input asp-for="Create.MainMenuControl" disabled="@createIsAdmin" /> 主界面</label>
            <label><input asp-for="Create.PowerControl" disabled="@createIsAdmin" /> 电源控制</label>
            <label><input asp-for="Create.ApiAccess" disabled="@createIsAdmin" /> API 访问</label>
            <label><input asp-for="Create.RequestScheduleSwap" disabled="@createIsAdmin" /> 老师主动换课</label>
            <label><input asp-for="Create.ForceScheduleSwap" disabled="@createIsAdmin" /> 强制换课</label>
        </fieldset>
        <p class="admin-permission-note" data-admin-permission-note hidden="@(!createIsAdmin)">
            管理员默认拥有全部权限，无需配置附加权限。
        </p>
        <button type="submit">创建账号</button>
    </form>
</section>

<section class="panel">
    <h2>现有账号</h2>
    <div class="user-account-table-wrap">
        <table class="user-account-table">
            <thead>
                <tr>
                    <th scope="col">账号名</th>
                    <th scope="col">ID</th>
                    <th scope="col">角色</th>
                    <th scope="col"><span class="visually-hidden">操作</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Accounts)
                {
                    var dialogId = $"user-edit-{user.Id:N}";
                    <tr>
                        <td data-label="账号名"><strong>@user.DisplayName</strong></td>
                        <td data-label="ID"><code>@user.Username</code></td>
                        <td data-label="角色"><span class="role-badge">@(user.Role == UserRole.Admin ? "管理员" : "学生")</span></td>
                        <td class="user-account-action">
                            <div class="account-row-actions">
                                @if (user.Role != UserRole.Admin)
                                {
                                    <form method="post" asp-page-handler="Delete" onsubmit="return confirm('确定删除此账号？')">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button class="danger ghost user-delete-button" type="submit">删除</button>
                                    </form>
                                }
                                <button type="button" class="ghost user-edit-button" disabled="@(user.Role == UserRole.Admin && Model.CurrentUser.Role != UserRole.Admin)" data-user-edit-open="@dialogId" aria-controls="@dialogId">编辑</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @foreach (var user in Model.Accounts)
    {
        var isAdmin = user.Role == UserRole.Admin;
        var canUseApi = user.EffectivePermissions.HasFlag(UserPermissions.ApiAccess);
        var apiKeys = Model.GetApiKeys(user.Id);
        var dialogId = $"user-edit-{user.Id:N}";
        <dialog id="@dialogId" class="user-edit-dialog" data-user-edit-dialog aria-labelledby="@($"{dialogId}-title")">
            <div class="user-edit-dialog-shell">
                <header class="user-edit-dialog-header">
                    <div>
                        <p class="eyebrow">编辑账号</p>
                        <h2 id="@($"{dialogId}-title")">@user.DisplayName</h2>
                        <small>ID：@user.Username</small>
                    </div>
                    <button type="button" class="ghost dialog-close-button" data-user-edit-close aria-label="关闭编辑窗口">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </header>

                <form method="post" asp-page-handler="Update" class="form-grid user-edit-form" data-role-form>
                    <input type="hidden" name="Edit.Id" value="@user.Id" />
                    <label>账号名<input name="Edit.DisplayName" value="@user.DisplayName" /></label>
                    <label>
                        角色
                        <select name="Edit.RoleId" data-role-select>
                            @foreach (var role in Model.RoleDefinitions.Where(role => Model.CurrentUser.Role == UserRole.Admin || role.Kind != "Administrator"))
                            { if (user.RoleId == role.Id) { <option value="@role.Id" data-admin="@(role.Kind == "Administrator" ? "true" : "false")" data-teacher="@(role.Kind == AccountRoleKind.Teacher.ToString() ? "true" : "false")" selected>@role.Name</option> } else { <option value="@role.Id" data-admin="@(role.Kind == "Administrator" ? "true" : "false")" data-teacher="@(role.Kind == AccountRoleKind.Teacher.ToString() ? "true" : "false")">@role.Name</option> } }
                        </select>
                    </label>
                    <label class="check user-enabled-check">
                        <input type="checkbox" name="Edit.Enabled" value="true" checked="@user.Enabled" /> 启用账号
                    </label>
                    <fieldset class="permissions" data-role-permissions hidden="@isAdmin">
                        <legend>附加权限</legend>
                        <label><input type="checkbox" name="Edit.AccessWebUi" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.AccessWebUi)" disabled="@isAdmin" /> 概览</label>
                        <label><input type="checkbox" name="Edit.ManageUsers" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.ManageUsers)" disabled="@isAdmin" /> 人员管理</label>
                        <label><input type="checkbox" name="Edit.SendNotifications" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.SendNotifications)" disabled="@isAdmin" /> 发送与清除通知</label><label><input type="checkbox" name="Edit.SendVoiceMessages" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.SendVoiceMessages)" disabled="@isAdmin" /> 发送语音</label>
                        <label><input type="checkbox" name="Edit.TeacherComing" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.TeacherComing)" disabled="@isAdmin" /> 老师来了</label>
                        <label><input type="checkbox" name="Edit.ManageSchedule" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.ManageSchedule)" disabled="@isAdmin" /> 换课</label>
                        <label><input type="checkbox" name="Edit.RunExtensions" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.RunExtensions)" disabled="@isAdmin" /> 扩展功能</label>
                        <label><input type="checkbox" name="Edit.MainMenuControl" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.MainMenuControl)" disabled="@isAdmin" /> 主界面</label>
                        <label><input type="checkbox" name="Edit.PowerControl" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.PowerControl)" disabled="@isAdmin" /> 电源控制</label>
                        <label><input type="checkbox" name="Edit.ApiAccess" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.ApiAccess)" disabled="@isAdmin" /> API 访问</label>
                        <label><input type="checkbox" name="Edit.RequestScheduleSwap" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.RequestScheduleSwap)" disabled="@isAdmin" /> 老师主动换课</label>
                        <label><input type="checkbox" name="Edit.ForceScheduleSwap" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.ForceScheduleSwap)" disabled="@isAdmin" /> 强制换课</label>
                    </fieldset>
                    <p class="admin-permission-note" data-admin-permission-note hidden="@(!isAdmin)">
                        管理员默认拥有全部权限，附加权限不可修改。
                    </p>
                    <div class="dialog-actions">
                        <button type="button" class="ghost" data-user-edit-close>取消</button>
                        <button type="submit">保存修改</button>
                    </div>
                </form>

                <section class="api-key-user-section" aria-labelledby="@($"{dialogId}-api-title")">
                    <div class="api-key-user-heading">
                        <div>
                            <h3 id="@($"{dialogId}-api-title")">API Key</h3>
                            <p>API Key 继承该账号当前权限；吊销或移除 API 访问权限后立即失效。</p>
                        </div>
                    </div>
                    @if (user.Role == UserRole.Admin && Model.CurrentUser.Role != UserRole.Admin)
                    {
                        <p class="muted">仅系统管理员可管理管理员账号的 API Key。</p>
                    }
                    else
                    {
                        @if (!canUseApi)
                        {
                            <p class="muted">该账号当前没有 API 访问权限，已有密钥已失效；仍可吊销不再使用的密钥。</p>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="CreateApiKey" class="api-key-create user-api-key-create">
                                <input type="hidden" name="id" value="@user.Id" />
                                <label>密钥名称<input name="name" maxlength="40" placeholder="例如：自动化脚本" /></label>
                                <button type="submit">生成 API Key</button>
                            </form>
                        }
                        @if (apiKeys.Count == 0)
                        {
                            @if (canUseApi)
                            {
                                <p class="muted">暂无 API Key。</p>
                            }
                        }
                        else
                        {
                            <div class="user-account-table-wrap">
                                <table class="user-account-table api-key-table">
                                    <thead>
                                        <tr>
                                            <th scope="col">名称</th>
                                            <th scope="col">前缀</th>
                                            <th scope="col">创建时间</th>
                                            <th scope="col">最近使用</th>
                                            <th scope="col">状态</th>
                                            <th scope="col"><span class="visually-hidden">操作</span></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var key in apiKeys)
                                    {
                                        <tr>
                                            <td data-label="名称"><strong>@key.Name</strong></td>
                                            <td data-label="前缀"><code>@key.Prefix…</code></td>
                                            <td data-label="创建时间">@key.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                            <td data-label="最近使用">@(key.LastUsedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "从未使用")</td>
                                            <td data-label="状态">
                                                @if (key.RevokedAt is not null)
                                                {
                                                    <span class="role-badge muted">已吊销</span>
                                                }
                                                else if (key.ExpiresAt is { } expiresAt && expiresAt <= DateTimeOffset.UtcNow)
                                                {
                                                    <span class="role-badge muted">已过期</span>
                                                }
                                                else
                                                {
                                                    <span class="role-badge">有效</span>
                                                }
                                            </td>
                                            <td class="user-account-action">
                                                @if (key.RevokedAt is null)
                                                {
                                                    <form method="post" asp-page-handler="RevokeApiKey" onsubmit="return confirm('吊销后使用该密钥的脚本会立即失效，确定继续吗？')">
                                                        <input type="hidden" name="id" value="@user.Id" />
                                                        <input type="hidden" name="keyId" value="@key.Id" />
                                                        <button type="submit" class="danger ghost">吊销</button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </section>

                <section class="user-danger-zone" aria-labelledby="@($"{dialogId}-danger-title")">
                    <div>
                        <h3 id="@($"{dialogId}-danger-title")">重置密码</h3>
                    </div>
                    <form method="post" asp-page-handler="ResetPassword" class="reset-password-form" data-password-confirmation>
                        <input type="hidden" name="id" value="@user.Id" />
                        <label>
                            新密码
                            <input name="password" type="password" minlength="8" maxlength="128" autocomplete="new-password" required data-new-password />
                        </label>
                        <label>
                            确认新密码
                            <input name="confirmPassword" type="password" minlength="8" maxlength="128" autocomplete="new-password" required data-confirm-password />
                        </label>
                        <button class="ghost" type="submit">重置密码</button>
                    </form>

                </section>
            </div>
        </dialog>
    }
</section>
