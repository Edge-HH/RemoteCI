@page
@model UsersModel
@{
    ViewData["Title"] = "人员权限";
    var createIsAdmin = Model.Create.Role == UserRole.Admin;
}
<div class="page-head">
    <div>
        <p class="eyebrow">账号与权限</p>
        <h1>人员管理</h1>
    </div>
</div>

<section class="panel">
    <h2>访客访问</h2>
    <p class="muted">启用后，登录页会出现「仅查看」，未登录访客只能浏览课表。自动进入访客页默认关闭，且仅在启用访客功能时可开启。</p>
    <form method="post" asp-page-handler="VisitorAccess" class="stack" data-visitor-access-form>
        <label class="check"><input asp-for="VisitorAccessEnabled" data-visitor-enabled /> 启用访客功能</label>
        <label class="check"><input asp-for="AutoEnterVisitorPage" data-visitor-auto-enter disabled="@(!Model.VisitorAccessEnabled)" /> 自动进入访客页</label>
        <button type="submit">保存访客设置</button>
    </form>
</section>

@if (Model.CurrentUser.Role == UserRole.Admin)
{
<section class="panel">
    <div class="panel-heading">
        <div><h2>角色配置</h2><p class="muted">角色默认权限会统一应用到所有同角色账号。</p></div>
        <button type="button" data-user-edit-open="role-create-dialog" aria-controls="role-create-dialog">创建角色</button>
    </div>
    <div class="user-account-table-wrap">
        <table class="user-account-table role-summary-table">
            <thead><tr><th scope="col">角色名称</th><th scope="col"><span class="visually-hidden">操作</span></th></tr></thead>
            <tbody>
            @foreach (var role in Model.RoleDefinitions)
            {
                var dialogId = $"role-edit-{role.Id:N}";
                <tr><td data-label="角色名称"><strong>@role.Name</strong></td><td class="user-account-action"><button type="button" class="ghost user-edit-button" data-user-edit-open="@dialogId" aria-controls="@dialogId">编辑</button></td></tr>
            }
            </tbody>
        </table>
    </div>

    @foreach (var role in Model.RoleDefinitions)
    {
        var dialogId = $"role-edit-{role.Id:N}";
        var locked = role.Kind == "Administrator";
        <dialog id="@dialogId" class="user-edit-dialog" data-user-edit-dialog aria-labelledby="@($"{dialogId}-title")">
            <div class="user-edit-dialog-shell">
                <header class="user-edit-dialog-header"><div><p class="eyebrow">编辑角色</p><h2 id="@($"{dialogId}-title")">@role.Name</h2><small>@role.UserCount 个账号正在使用</small></div><button type="button" class="ghost dialog-close-button" data-user-edit-close aria-label="关闭编辑窗口"><i class="bi bi-x-lg" aria-hidden="true"></i></button></header>
                @if (locked)
                {
                    <div class="role-dialog-body"><p class="admin-permission-note">管理员固定拥有全部权限，不可修改。</p><div class="dialog-actions"><button type="button" class="ghost" data-user-edit-close>关闭</button></div></div>
                }
                else
                {
                    <form method="post" asp-page-handler="UpdateRole" class="stack role-edit-dialog-form"><input type="hidden" name="RoleEdit.Id" value="@role.Id" /><label>角色名称<input name="RoleEdit.Name" value="@role.Name" readonly="@(role.Kind != "Custom")" /></label><fieldset class="permissions"><legend>默认权限</legend><label><input type="checkbox" name="RoleEdit.AccessWebUi" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.AccessWebUi)" /> 概览</label><label><input type="checkbox" name="RoleEdit.ManageUsers" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.ManageUsers)" /> 人员管理</label><label><input type="checkbox" name="RoleEdit.SendNotifications" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.SendNotifications)" /> 发送与清除通知</label><label><input type="checkbox" name="RoleEdit.SendVoiceMessages" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.SendVoiceMessages)" /> 发送语音</label><label><input type="checkbox" name="RoleEdit.TeacherComing" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.TeacherComing)" /> 老师来了</label><label><input type="checkbox" name="RoleEdit.ManageSchedule" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.ManageSchedule)" /> 换课</label><label><input type="checkbox" name="RoleEdit.RunExtensions" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.RunExtensions)" /> 扩展功能</label><label><input type="checkbox" name="RoleEdit.MainMenuControl" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.MainMenuControl)" /> 主界面</label><label><input type="checkbox" name="RoleEdit.PowerControl" value="true" checked="@role.DefaultPermissions.HasFlag(UserPermissions.PowerControl)" /> 电源控制</label></fieldset><div class="dialog-actions"><button type="button" class="ghost" data-user-edit-close>取消</button><button type="submit">保存角色</button></div></form>
                    @if (role.Kind == "Custom") { <section class="user-danger-zone"><div><h3>删除角色</h3><p>只有未被账号使用的角色才能删除。</p></div><form method="post" asp-page-handler="DeleteRole" class="delete-user-form" onsubmit="return confirm('确定删除此角色？')"><input type="hidden" name="id" value="@role.Id" /><button type="submit" class="danger ghost">删除角色</button></form></section> }
                }
            </div>
        </dialog>
    }

    <dialog id="role-create-dialog" class="user-edit-dialog" data-user-edit-dialog aria-labelledby="role-create-dialog-title">
        <div class="user-edit-dialog-shell"><header class="user-edit-dialog-header"><div><p class="eyebrow">新建角色</p><h2 id="role-create-dialog-title">创建角色</h2></div><button type="button" class="ghost dialog-close-button" data-user-edit-close aria-label="关闭创建窗口"><i class="bi bi-x-lg" aria-hidden="true"></i></button></header><form method="post" asp-page-handler="CreateRole" class="stack role-edit-dialog-form"><label>角色名称<input name="RoleEdit.Name" maxlength="40" required /></label><fieldset class="permissions"><legend>默认权限</legend><label><input type="checkbox" name="RoleEdit.AccessWebUi" value="true" /> 概览</label><label><input type="checkbox" name="RoleEdit.ManageUsers" value="true" /> 人员管理</label><label><input type="checkbox" name="RoleEdit.SendNotifications" value="true" /> 发送与清除通知</label><label><input type="checkbox" name="RoleEdit.SendVoiceMessages" value="true" /> 发送语音</label><label><input type="checkbox" name="RoleEdit.TeacherComing" value="true" /> 老师来了</label><label><input type="checkbox" name="RoleEdit.ManageSchedule" value="true" /> 换课</label><label><input type="checkbox" name="RoleEdit.RunExtensions" value="true" /> 扩展功能</label><label><input type="checkbox" name="RoleEdit.MainMenuControl" value="true" /> 主界面</label><label><input type="checkbox" name="RoleEdit.PowerControl" value="true" /> 电源控制</label></fieldset><div class="dialog-actions"><button type="button" class="ghost" data-user-edit-close>取消</button><button type="submit">创建角色</button></div></form></div>
    </dialog>
</section>
}

<section class="panel">
    <h2>新建账号</h2>
    <form method="post" asp-page-handler="Create" class="form-grid" data-async-user-create data-role-form>
        <div class="form-error error" data-create-user-error role="alert" hidden></div>
        <label>ID<input asp-for="Create.Username" autocomplete="off" /></label>
        <label>账号名<input asp-for="Create.DisplayName" autocomplete="off" /></label>
        <label>初始密码<input asp-for="Create.Password" type="password" autocomplete="new-password" /></label>
        <label>
            角色
            <select asp-for="Create.RoleId" data-role-select>
                @foreach (var role in Model.RoleDefinitions.Where(role => Model.CurrentUser.Role == UserRole.Admin || role.Kind != "Administrator")) { <option value="@role.Id" data-admin="@(role.Kind == "Administrator" ? "true" : "false")">@role.Name</option> }
            </select>
        </label>
        <fieldset class="permissions" data-role-permissions hidden="@createIsAdmin">
            <legend>附加权限</legend>
            <label><input asp-for="Create.AccessWebUi" disabled="@createIsAdmin" /> 概览</label>
            <label><input asp-for="Create.ManageUsers" disabled="@createIsAdmin" /> 人员管理</label>
            <label><input asp-for="Create.SendNotifications" disabled="@createIsAdmin" /> 发送与清除通知</label><label><input asp-for="Create.SendVoiceMessages" disabled="@createIsAdmin" /> 发送语音</label>
            <label><input asp-for="Create.TeacherComing" disabled="@createIsAdmin" /> 老师来了</label>
            <label><input asp-for="Create.ManageSchedule" disabled="@createIsAdmin" /> 换课</label>
            <label><input asp-for="Create.RunExtensions" disabled="@createIsAdmin" /> 扩展功能</label>
            <label><input asp-for="Create.MainMenuControl" disabled="@createIsAdmin" /> 主界面</label>
            <label><input asp-for="Create.PowerControl" disabled="@createIsAdmin" /> 电源控制</label>
        </fieldset>
        <p class="admin-permission-note" data-admin-permission-note hidden="@(!createIsAdmin)">
            管理员默认拥有全部权限，无需配置附加权限。
        </p>
        <button type="submit">创建账号</button>
    </form>
</section>

<section class="panel">
    <h2>现有账号</h2>
    <div class="user-account-table-wrap">
        <table class="user-account-table">
            <thead>
                <tr>
                    <th scope="col">账号名</th>
                    <th scope="col">ID</th>
                    <th scope="col">角色</th>
                    <th scope="col"><span class="visually-hidden">操作</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Accounts)
                {
                    var dialogId = $"user-edit-{user.Id:N}";
                    <tr>
                        <td data-label="账号名"><strong>@user.DisplayName</strong></td>
                        <td data-label="ID"><code>@user.Username</code></td>
                        <td data-label="角色"><span class="role-badge">@(user.Role == UserRole.Admin ? "管理员" : "学生")</span></td>
                        <td class="user-account-action">
                            <div class="account-row-actions">
                                @if (user.Role != UserRole.Admin)
                                {
                                    <form method="post" asp-page-handler="Delete" onsubmit="return confirm('确定删除此账号？')">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button class="danger ghost user-delete-button" type="submit">删除</button>
                                    </form>
                                }
                                <button type="button" class="ghost user-edit-button" disabled="@(user.Role == UserRole.Admin && Model.CurrentUser.Role != UserRole.Admin)" data-user-edit-open="@dialogId" aria-controls="@dialogId">编辑</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @foreach (var user in Model.Accounts)
    {
        var isAdmin = user.Role == UserRole.Admin;
        var dialogId = $"user-edit-{user.Id:N}";
        <dialog id="@dialogId" class="user-edit-dialog" data-user-edit-dialog aria-labelledby="@($"{dialogId}-title")">
            <div class="user-edit-dialog-shell">
                <header class="user-edit-dialog-header">
                    <div>
                        <p class="eyebrow">编辑账号</p>
                        <h2 id="@($"{dialogId}-title")">@user.DisplayName</h2>
                        <small>ID：@user.Username</small>
                    </div>
                    <button type="button" class="ghost dialog-close-button" data-user-edit-close aria-label="关闭编辑窗口">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </header>

                <form method="post" asp-page-handler="Update" class="form-grid user-edit-form" data-role-form>
                    <input type="hidden" name="Edit.Id" value="@user.Id" />
                    <label>账号名<input name="Edit.DisplayName" value="@user.DisplayName" /></label>
                    <label>
                        角色
                        <select name="Edit.RoleId" data-role-select>
                            @foreach (var role in Model.RoleDefinitions.Where(role => Model.CurrentUser.Role == UserRole.Admin || role.Kind != "Administrator"))
                            { if (user.RoleId == role.Id) { <option value="@role.Id" data-admin="@(role.Kind == "Administrator" ? "true" : "false")" selected>@role.Name</option> } else { <option value="@role.Id" data-admin="@(role.Kind == "Administrator" ? "true" : "false")">@role.Name</option> } }
                        </select>
                    </label>
                    <label class="check user-enabled-check">
                        <input type="checkbox" name="Edit.Enabled" value="true" checked="@user.Enabled" /> 启用账号
                    </label>
                    <fieldset class="permissions" data-role-permissions hidden="@isAdmin">
                        <legend>附加权限</legend>
                        <label><input type="checkbox" name="Edit.AccessWebUi" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.AccessWebUi)" disabled="@isAdmin" /> 概览</label>
                        <label><input type="checkbox" name="Edit.ManageUsers" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.ManageUsers)" disabled="@isAdmin" /> 人员管理</label>
                        <label><input type="checkbox" name="Edit.SendNotifications" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.SendNotifications)" disabled="@isAdmin" /> 发送与清除通知</label><label><input type="checkbox" name="Edit.SendVoiceMessages" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.SendVoiceMessages)" disabled="@isAdmin" /> 发送语音</label>
                        <label><input type="checkbox" name="Edit.TeacherComing" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.TeacherComing)" disabled="@isAdmin" /> 老师来了</label>
                        <label><input type="checkbox" name="Edit.ManageSchedule" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.ManageSchedule)" disabled="@isAdmin" /> 换课</label>
                        <label><input type="checkbox" name="Edit.RunExtensions" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.RunExtensions)" disabled="@isAdmin" /> 扩展功能</label>
                        <label><input type="checkbox" name="Edit.MainMenuControl" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.MainMenuControl)" disabled="@isAdmin" /> 主界面</label>
                        <label><input type="checkbox" name="Edit.PowerControl" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.PowerControl)" disabled="@isAdmin" /> 电源控制</label>
                    </fieldset>
                    <p class="admin-permission-note" data-admin-permission-note hidden="@(!isAdmin)">
                        管理员默认拥有全部权限，附加权限不可修改。
                    </p>
                    <div class="dialog-actions">
                        <button type="button" class="ghost" data-user-edit-close>取消</button>
                        <button type="submit">保存修改</button>
                    </div>
                </form>

                <section class="user-danger-zone" aria-labelledby="@($"{dialogId}-danger-title")">
                    <div>
                        <h3 id="@($"{dialogId}-danger-title")">账号安全操作</h3>
                        <p>重置密码或删除账号前，请确认操作对象无误。</p>
                    </div>
                    <form method="post" asp-page-handler="ResetPassword" class="reset-password-form" data-password-confirmation>
                        <input type="hidden" name="id" value="@user.Id" />
                        <label>
                            新密码
                            <input name="password" type="password" minlength="8" maxlength="128" autocomplete="new-password" required data-new-password />
                        </label>
                        <label>
                            确认新密码
                            <input name="confirmPassword" type="password" minlength="8" maxlength="128" autocomplete="new-password" required data-confirm-password />
                        </label>
                        <button class="ghost" type="submit">重置密码</button>
                    </form>

                </section>
            </div>
        </dialog>
    }
</section>
