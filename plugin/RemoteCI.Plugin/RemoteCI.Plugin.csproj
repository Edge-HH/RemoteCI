<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ClassIsland 2.0.x 运行在 .NET 8；以最低共同运行时为基线可兼容后续 2.x 宿主。 -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>RemoteCI.Plugin</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RemoteCI.Plugin</AssemblyName>
    <!-- 软件版本与协议版本独立，Release 工作流会用标签覆盖此默认值。 -->
    <Version>3.2.1.3</Version>
    <!-- CIPX target 会压缩整个 OutputPath；将 publish 输出移出该目录，避免二次打包时嵌套 publish/。 -->
    <PublishDir>$(BaseOutputPath)publish/$(Configuration)/$(TargetFramework)/</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      插件只使用 ClassIsland 2.0 公共 API，并以程序集版本为 2.0.0.0 的首个 2.x SDK 编译。
      .NET 会允许较新的宿主程序集满足较低版本引用，从而覆盖整个 2.x 系列。
      SDK 运行时由 ClassIsland 宿主提供，插件包内不携带，避免类型冲突。
    -->
    <PackageReference Include="ClassIsland.PluginSdk" Version="2.0.0-dev-v2">
      <ExcludeAssets>runtime; native</ExcludeAssets>
    </PackageReference>
    <!-- ClassIsland SDK 经 Avalonia 传入的 0.21.2 存在 GHSA-xrw6-gwf8-vvr9；固定到兼容分支的修复版。 -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.0">
      <ExcludeAssets>runtime; native</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Fleck：嵌入式 WebSocket 服务器（MIT），用于局域网直连，不依赖 ASP.NET Core 运行时 -->
    <PackageReference Include="Fleck" Version="1.2.0" />
    <!--
      ClassIsland 暂未公开通知发送事件；Harmony 仅在运行时旁路观察统一发送入口，不替换原有显示流程。
      宿主 ClassIsland 2.x 自带 MonoMod 版 0Harmony（程序集版本 2.4.2.0）。若插件包再携带一份标准版
      0Harmony，运行时同名不同实现，Patch 时会在共享状态上抛 TypeLoadException，导致插件启动中断。
      因此这里只保留编译期引用，运行时统一解析宿主自带的 0Harmony。
    -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2">
      <ExcludeAssets>runtime; native</ExcludeAssets>
    </PackageReference>
    <!-- NAudio.Wasapi：通过 Windows Core Audio 读取和控制默认播放设备的主音量。 -->
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <!-- DPAPI（Windows 数据保护接口）：加密插件长期凭据；非 Windows 时按明文回退。 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../shared/RemoteCI.Shared/RemoteCI.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RemoteCI.Plugin.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../LICENSE" Link="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
