<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 最低支持 ClassIsland 2.1.0（.NET 8）；2.1.1 起宿主运行在 .NET 10，仍可加载 net8.0 插件。 -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!--
      ClassIsland 2.1.1.1 起同时提供 x86 / x64 / arm64 的 Windows 宿主，插件必须保持 AnyCPU，
      才能随宿主进程的架构加载（x64 专用程序集会被 x86 宿主以 FileLoadException 拒绝）。
      插件自身与运行时依赖（RemoteCI.Shared、Fleck、NAudio.Wasapi、ProtectedData）均为 IL-only
      程序集，不含本机代码，因此 AnyCPU 不会引入额外的架构限制。
    -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>RemoteCI.Plugin</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RemoteCI.Plugin</AssemblyName>
    <!-- 软件版本与协议版本独立，Release 工作流会用标签覆盖此默认值。 -->
    <Version>3.2.1.4</Version>
    <!-- CIPX target 会压缩整个 OutputPath；将 publish 输出移出该目录，避免二次打包时嵌套 publish/。 -->
    <PublishDir>$(BaseOutputPath)publish/$(Configuration)/$(TargetFramework)/</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      以最后一个 .NET 8 SDK（2.1.0.1）编译，最低支持 ClassIsland 2.1.0；2.0.x 不再适配。
      2.1.1 起少数公开成员改了类型（见 HostApiCompat），这些成员按名称反射访问；
      PluginApiCompatibilityTests 会核对插件对 2.1.0.1 与 2.1.1.1 宿主的全部引用。
      SDK 运行时由 ClassIsland 宿主提供，插件包内不携带，避免类型冲突。
    -->
    <PackageReference Include="ClassIsland.PluginSdk" Version="2.1.0.1">
      <ExcludeAssets>runtime; native</ExcludeAssets>
    </PackageReference>
    <!-- ClassIsland SDK 经 Avalonia 传入的 0.21.2 存在 GHSA-xrw6-gwf8-vvr9；固定到兼容分支的修复版。 -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3">
      <ExcludeAssets>runtime; native</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Fleck：嵌入式 WebSocket 服务器（MIT），用于局域网直连，不依赖 ASP.NET Core 运行时 -->
    <PackageReference Include="Fleck" Version="1.2.0" />
    <!--
      ClassIsland 暂未公开通知发送事件；Harmony 仅在运行时旁路观察统一发送入口，不替换原有显示流程。
      宿主 ClassIsland 2.x 自带 MonoMod 版 0Harmony（程序集版本 2.4.2.0）。若插件包再携带一份标准版
      0Harmony，运行时同名不同实现，Patch 时会在共享状态上抛 TypeLoadException，导致插件启动中断。
      因此这里只保留编译期引用，运行时统一解析宿主自带的 0Harmony。
    -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2">
      <ExcludeAssets>runtime; native</ExcludeAssets>
    </PackageReference>
    <!-- NAudio.Wasapi：通过 Windows Core Audio 读取和控制默认播放设备的主音量。 -->
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <!-- DPAPI（Windows 数据保护接口）：加密插件长期凭据；非 Windows 时按明文回退。 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../shared/RemoteCI.Shared/RemoteCI.Shared.csproj" />
    <!--
      应用守护进程（.NET Framework 4.8）只随插件包分发，不作为程序集引用；插件运行时把它复制到
      %LOCALAPPDATA%\RemoteCI\Guard 再启动，这样 ClassIsland 被删除后守护进程仍能运行。
    -->
    <ProjectReference Include="../RemoteCI.Guard/RemoteCI.Guard.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      SetTargetFramework="TargetFramework=net48"
                      Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 插件与守护进程之间的文件契约、守护逻辑与备份逻辑：两边共用同一份源码。 -->
    <Compile Include="../RemoteCI.Guard/Shared/*.cs" LinkBase="Guard" />
    <None Include="../RemoteCI.Guard/bin/$(Configuration)/RemoteCI.Guard.exe" Link="RemoteCI.Guard.exe" Visible="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RemoteCI.Plugin.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../LICENSE" Link="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
